@@ -45,33 +45,33 @@ experimental {
 group {
     proxy {
         policy: min_moving_avg
+        # Include every node the subscription provides. Without a filter the
+        # group resolves 0 nodes and the proxy has no outbound at all.
+        filter: name(keyword: '')
     }
 }
 
 dns {
-    # 直连查询带上客户端网段，国内 CDN 才会返回就近地址
-    client_subnet: auto
+    # Every DNS query belongs to the local SmartDNS. It does the CN/foreign
+    # split itself; its foreign DoH/bootstrap is caught by the geoip rules
+    # below because those resolver IPs are not in geoip:cn. Do not add a
+    # remote upstream here: that would bypass SmartDNS.
     upstream {
-        default: 'https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com' -> direct
-        remote: 'https://8.8.8.8/dns-query?tls_server_name=dns.google' -> proxy
+        default: 'udp://127.0.0.1:53' -> direct
     }
     routing {
         request {
+            qname(suffix: lan) -> default
+            qname(suffix: local) -> default
             qname(geosite: private) -> asis
-            qname(geosite: cn) -> default
-            fallback: remote
-        }
-        # 远端返回国内 IP 时也采信，避免两边解析结果不一致
-        response {
-            upstream(remote) -> accept
-            qname(geosite: private) -> accept
-            ip(geoip: cn) -> accept
-            fallback: remote
+            fallback: default
         }
     }
 }
 
 routing {
+    # DNS itself is never proxied: SmartDNS is the only resolver.
+    dport(53) -> direct(must)
     dip(224.0.0.0/3, 'ff00::/8') -> direct
     # 其它代理核心和 DNS 守护进程的出站不能再被抓一次，否则成环。
     pname(AdGuardHome, mosdns, mihomo, sing-box, clash, frpc, xray, v2ray) -> direct(must)
diff --git a/honk/files/control.sh b/honk/files/control.sh
index 3e3feb2..52d6914 100755
--- a/honk/files/control.sh
+++ b/honk/files/control.sh
@@ -1326,6 +1326,30 @@ panel_managed_system() {
 	return 1
 }
 
+# 启动时自动收尾被中断的维护事务。只在没有任何在途操作时动手：
+#   * HONK_MAINT_CAP 由 maintenance.sh 在恢复/回滚过程中导出，不能抢；
+#   * 签名更新（/etc/.honk-update）需要重装完整包集，不能自动回滚；
+#   * 活锁 / 非托管 honk-core 说明还有人在用，保持原状让 UI 报错。
+# 回滚本身不启动服务（HONK_RECOVER_NO_START=1），由调用方继续正常的启动流程，
+# 避免 start_service -> recover -> start_service 的递归。
+auto_recover() {
+	[ -n "${HONK_MAINT_CAP:-}" ] && return 0
+	if [ -e /etc/.honk-update/journal ] || [ -L /etc/.honk-update/journal ]; then
+		return 0
+	fi
+	if [ ! -d "$HONK_LOCK_DIR" ] && [ ! -e "$HONK_MAINT_JOURNAL" ] && [ ! -L "$HONK_MAINT_JOURNAL" ]; then
+		return 0
+	fi
+	if [ -d "$HONK_LOCK_DIR" ]; then
+		[ -r "$HONK_LOCK_DIR/pid" ] || return 1
+		honk_lock_is_stale || return 1
+	fi
+	pidof honk-core >/dev/null 2>&1 && return 1
+	logger -t honk "recovering interrupted maintenance transaction" 2>/dev/null || :
+	rm -rf "$HONK_LOCK_DIR" 2>/dev/null || :
+	HONK_RECOVER_NO_START=1 /usr/share/honk/maintenance.sh recover >/dev/null 2>&1
+}
+
 case "$1" in
 	check)
 		preflight
@@ -1367,8 +1391,11 @@ case "$1" in
 	recover)
 		recover
 		;;
+	auto-recover)
+		auto_recover
+		;;
 	*)
-		echo "usage: $0 {check|diagnose|preflight|local-direct|local-direct-file|initialize|settings|repair|detach|recover|write-system|panel-managed}" >&2
+		echo "usage: $0 {check|diagnose|preflight|local-direct|local-direct-file|initialize|settings|repair|detach|recover|auto-recover|write-system|panel-managed}" >&2
 		exit 2
 		;;
 esac
diff --git a/honk/files/direct-unspec b/honk/files/direct-unspec
new file mode 100644
index 0000000..0344779
--- /dev/null
+++ b/honk/files/direct-unspec
@@ -0,0 +1,10 @@
+honk-core built with the mydist direct hand-back patch (p1).
+
+Direct-classified flows return TC_ACT_UNSPEC and carry DIRECT_UNSPEC_MARK, so the
+classic TC chain (mydist's dpd) sees them and can keep accelerating direct
+traffic while honk proxies the rest. Proxy and block verdicts remain terminal for
+honk, and NAT stays with einat on the WAN.
+
+Absence of this file means an unpatched core: dpd must stay in observe while honk
+owns the LAN TCX, because its direct exits return TC_ACT_OK and the classic chain
+is never reached.
diff --git a/honk/files/honk.init b/honk/files/honk.init
index 1db7625..251588d 100755
--- a/honk/files/honk.init
+++ b/honk/files/honk.init
@@ -17,6 +17,14 @@ boot() {
 
 start_service() {
 	local enabled initialized config_file ready_token ready_hash ready_runtime ready_api_enabled ready_api_listen ready_clash_api_listen ready_clash_api_secret_set old_ready_token
+	# 掉电或 UI 任务被杀会留下 /etc/.honk-maintenance/journal。必须在
+	# enabled/initialized 判断之前收尾：中断的 restore/reset 可能把 enabled 写回 0，
+	# 那样服务永远起不来，状态页也就一直卡在“需要恢复系统”。
+	if ! "$HONK_CONTROL" auto-recover >/dev/null 2>&1; then
+		if [ -e /etc/.honk-maintenance/journal ] || [ -L /etc/.honk-maintenance/journal ]; then
+			logger -t honk "interrupted maintenance transaction still needs manual recovery"
+		fi
+	fi
 	config_load honk
 	config_get_bool enabled main enabled 0
 	config_get_bool initialized main initialized 0
