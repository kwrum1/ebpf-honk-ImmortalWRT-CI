include {
    system.dae
}

group {
    proxy {
        policy: min_moving_avg
        # Include every node the subscription provides. Without a filter the
        # group resolves 0 nodes and the proxy has no outbound at all.
        filter: name(keyword: '')
    }
}

dns {
    # Every DNS query belongs to the local SmartDNS. It does the CN/foreign
    # split itself and its own foreign DoH is routed through this proxy by the
    # dip(...) rule below. Do not add a remote upstream here: that would
    # bypass SmartDNS (and was the reason foreign lookups used 8.8.8.8
    # directly instead of the local resolver).
    upstream {
        default: 'udp://127.0.0.1:53' -> direct
    }
    routing {
        request {
            qname(suffix: lan) -> default
            qname(suffix: local) -> default
            qname(geosite: private) -> asis
            fallback: default
        }
    }
}

routing {
    # DNS itself is never proxied: SmartDNS is the only resolver.
    dport(53) -> direct(must)
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    # 路由器自身地址直连，管理面板不被代理；服务启动时按本机地址重写下面区块
    # honk:local-direct-begin
    # honk:local-direct-end
    dip(geoip: private) && !dport(53) -> direct(must)
    dip(geoip: cn) && !dport(53) -> direct(must)
    # SmartDNS's foreign DoH/bootstrap goes through the proxy. These are the
    # resolver IPs its default group uses; the CN group stays on domestic DoH
    # and is covered by the geoip:cn/domain rules.
    dip(1.1.1.1, 1.0.0.1, 8.8.8.8, 8.8.4.4, 9.9.9.9, 149.112.112.112, 94.140.14.14, 94.140.15.15, 208.67.222.222, 208.67.220.220) -> proxy
    domain(geosite: cn) -> direct
    fallback: direct
}
