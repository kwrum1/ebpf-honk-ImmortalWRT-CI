#!/bin/sh
# 开机自启是内置行为：装上就 enable，是否真正启动由 honk.main.enabled 决定，
# 不再提供单独的 boot_enabled 开关。
/etc/init.d/honk enable

# Keep .lan/.local names working when the core's DNS controller intercepts port
# 53: send those suffixes to the default (SmartDNS) upstream. Older conffiles do
# not carry the rule; add it once. Without it a private-domain lookup falls
# through to the proxy/DoH fallback and answers NXDOMAIN on a box with no node.
if [ -f /etc/honk/config.dae ] && ! grep -q 'qname(suffix: lan)' /etc/honk/config.dae; then
	sed -i 's/^\([[:space:]]*\)qname(geosite: private) -> asis/\1qname(suffix: lan) -> default\n\1qname(suffix: local) -> default\n\1qname(geosite: private) -> asis/' /etc/honk/config.dae
fi

# The native API/UI (doona on port 9527) used to bind loopback only, so the
# controller page could not be opened from the LAN. system.dae is a conffile:
# upgrades keep the old copy, so rewrite it once here.
if [ -f /etc/honk/system.dae ] && grep -q "listen: '127.0.0.1:9527'" /etc/honk/system.dae; then
	sed -i "s/listen: '127\.0\.0\.1:9527'/listen: '0.0.0.0:9527'/" /etc/honk/system.dae
fi

# All DNS must go to the local SmartDNS. Stock and older conffiles send
# non-CN queries to 8.8.8.8 through the proxy, which bypasses SmartDNS's
# split entirely. Collapse the dns block to one upstream (127.0.0.1:53,
# direct) with fallback default; the dip(...) rule below then sends the DoH
# that SmartDNS itself uses through the proxy.
if [ -f /etc/honk/config.dae ] && grep -qE '^[[:space:]]*(remote:|fallback:[[:space:]]*remote)' /etc/honk/config.dae; then
	sed -i \
		-e '/^[[:space:]]*remote:.*->.*proxy[[:space:]]*$/d' \
		-e 's/^\([[:space:]]*\)fallback: remote/\1fallback: default/' \
		-e "s|^\([[:space:]]*\)default: .*-> direct[[:space:]]*$|\1default: 'udp://127.0.0.1:53' -> direct|" \
		/etc/honk/config.dae
fi

# The stock group has no filter, so it resolves 0 nodes even when the
# subscription carries some. Include every node.
if [ -f /etc/honk/config.dae ] && ! grep -q 'filter: name' /etc/honk/config.dae; then
	sed -i "s|^\([[:space:]]*\)policy: min_moving_avg|\1policy: min_moving_avg\n\1filter: name(keyword: '')|" /etc/honk/config.dae
fi

# SmartDNS foreign DoH/bootstrap goes through the proxy. Clients use the local
# SmartDNS; its default group is Cloudflare/Google DoH, which are unreachable
# from a Chinese line. Honk sees the router's own traffic through its cgroup
# hooks, so routing these destination IPs to the proxy makes the foreign half
# of the split resolve without any smartdns-side proxy knowledge. CN domains
# stay on the domestic DoH and are routed direct by the rule below.
if [ -f /etc/honk/config.dae ] && ! grep -q 'ebpf: doh-proxy' /etc/honk/config.dae; then
	sed -i 's|^\([[:space:]]*\)domain(geosite: cn) -> direct|\1# ebpf: doh-proxy -- smartdns foreign DoH/bootstrap via the proxy\n\1dip(1.1.1.1, 1.0.0.1, 8.8.8.8, 8.8.4.4, 9.9.9.9, 149.112.112.112, 94.140.14.14, 94.140.15.15, 208.67.222.222, 208.67.220.220) -> proxy\n\1domain(geosite: cn) -> direct|' /etc/honk/config.dae
fi

# Force NFQUEUE off, unconditionally.
#
# This image does not ship nft_queue / nfnetlink_queue (the TCX datapath does
# not use them), but /etc/honk/system.dae is a conffile: a keep-settings
# upgrade keeps the old `nfqueue_enable: true`, and the packaged
# control.sh/maintenance.sh rewrite the flag back to true. Either one makes
# honk's preflight refuse to start ("缺少内核模块 nft_queue"). Sed all three
# here; the packaged files are also patched at build time, this is the
# upgrade-time safety net.
for f in /etc/honk/system.dae /usr/share/honk/control.sh /usr/share/honk/maintenance.sh; do
	[ -f "$f" ] && sed -i 's/nfqueue_enable: true/nfqueue_enable: false/g' "$f"
done

# 配置模式已取消：只清遗留键，活动配置与启停状态一概不动。
legacy_mode=$(uci -q get honk.main.config_mode 2>/dev/null)
if [ -n "$legacy_mode" ]; then
	uci -q delete honk.main.config_mode && uci -q commit honk
fi

exit 0
