#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Re-attach/refresh the dpd fastpath whenever an interface comes up, changes
# address, or goes away. This is what makes pppoe-wan work: that device simply
# does not exist when /etc/init.d/dpd-fastpath runs at boot, and it may be
# destroyed and recreated on every PPPoE redial.
#
# ACTION values are netifd's, and they are NOT add/update:
#
#   ifup / ifdown   the L3 interface went up / down, DEVICE is set
#   ifupdate        an address or route changed, DEVICE is set
#   add / update    the *section* appeared / was edited; DEVICE may be empty
#
# Verified against the iface hotplug scripts already in this tree (ddns,
# tailscale, eqos, syncdial, xlnetacc): every one of them tests for ifup.
# Listening only on add|update was the reason the program was never attached
# on the first boot -- the init script reported "started" while bpftool showed
# no program and no map existed at all.

. /lib/functions.sh
. /usr/libexec/dpd-fastpath.sh

[ -n "$ACTION" ] || exit 0

dpd_uci() {
	config_load dpd_fastpath
	config_get_bool DPD_ENABLED global enabled 1
	config_get DPD_MODE global mode off
	config_get DPD_REDIRECT global redirect auto
	config_get DPD_TTL global flow_ttl_ms 5000
	config_get DPD_REFRESH global flow_refresh_ms 250
	config_get DPD_IFACES global interfaces 'lan'
	config_get DPD_POLICY global policy 'allow_all'
	config_get DPD_VLANS global vlans ''
	config_get_bool DPD_DOWNLINK global downlink 0
	# The configured mode is only a request; the gates may lower it. Evaluated
	# per event, exactly like the init script does, so a hotplug cannot undo a
	# downgrade.
	DPD_EMODE="$(dpd_gate_mode "$DPD_MODE")"
}

dpd_selected() {
	local i

	[ -n "$INTERFACE" ] || return 1
	for i in $DPD_IFACES; do
		[ "$i" = "$INTERFACE" ] && return 0
		[ -n "$DEVICE" ] && [ "$i" = "$DEVICE" ] && return 0
	done
	return 1
}

dpd_push_config() {
	[ -x "$DPD_CTL" ] || return 0
	dpd_is_attached "$DEVICE" || return 0
	dpd_teach_iface "$DEVICE"
	"$DPD_CTL" set mode "$DPD_EMODE" 2>/dev/null
	"$DPD_CTL" set redirect "$DPD_REDIRECT" 2>/dev/null
	"$DPD_CTL" set ttl "$DPD_TTL" 2>/dev/null
	"$DPD_CTL" set refresh "$DPD_REFRESH" 2>/dev/null
	"$DPD_CTL" set policy "$DPD_POLICY" 2>/dev/null
	"$DPD_CTL" set enable "$DPD_ENABLED" 2>/dev/null
	# also re-publish the vlan allow-list, so a hotplug that lands before the
	# init script ran still ends up with the configured policy in place
	dpd_push_vlans "$DPD_POLICY" "$DPD_VLANS"
	return 0
}

case "$ACTION" in
ifup|ifupdate|add|update)
	dpd_uci
	# Any link/address event can invalidate a cached egress (new device index,
	# new route, flushed neighbour). One store drops the whole cache instead
	# of the per-packet re-validation ABI 9 removed.
	dpd_bump_epoch
	config_get_bool attach global attach 1
	[ "$attach" = "1" ] || exit 0
	[ -n "$DEVICE" ] || exit 0

	# The uplink is attached only when `option downlink '1'`: taking a packet
	# over on the WAN skips router-acl's nft guard and the input path for
	# router-destined packets, so the default is to leave it alone. (The older
	# code attached it for "telemetry" while the effective mode was observe and
	# then left the filter behind when einat came up and the gate moved to
	# stateless -- i.e. it silently started accelerating inbound, exactly what
	# the rule forbids. Removed 2026-10-18.)
	#
	# It always has to be *taught*, though: the emitting device for every LAN->WAN
	# flow is the uplink, and `redirect auto` can only choose bpf_redirect()
	# over bpf_redirect_neigh() if it knows that device's L2 capabilities
	# (IFF_NOARP | IFF_POINTOPOINT for ppp). Teaching writes one entry into
	# dpd_iface and installs nothing.
	if dpd_is_wan_device "$DEVICE"; then
		dpd_teach_iface "$DEVICE"
		if [ "$DPD_DOWNLINK" = 1 ]; then
			if dpd_attach_if "$DEVICE"; then
				dpd_push_config
				dpd_mode_wants_accel "$DPD_EMODE" && ! dpd_chain_guard "$DEVICE" &&
					dpd_log "chain guard: a bpf filter sits after us on uplink $DEVICE"
				dpd_log "hotplug $ACTION $INTERFACE -> $DEVICE downlink attached (effective mode $DPD_EMODE)"
			else
				dpd_log "hotplug $ACTION $INTERFACE -> $DEVICE downlink attach deferred"
			fi
			exit 0
		fi
		dpd_log "hotplug $ACTION $INTERFACE -> $DEVICE is the uplink: L2 flags taught, never attached"
		exit 0
	fi

	dpd_selected || exit 0

	if dpd_attach_if "$DEVICE"; then
		if dpd_mode_wants_accel "$DPD_EMODE" && ! dpd_chain_guard "$DEVICE"; then
			dpd_log "gate: downgrading to observe because of the filter chain on $DEVICE"
			DPD_EMODE=observe
		fi
		dpd_push_config
		dpd_log "hotplug $ACTION $INTERFACE -> $DEVICE attached (effective mode $DPD_EMODE)"
	elif [ ! -e "/sys/class/net/$DEVICE" ]; then
		# Not a failure: the device does not exist yet. netifd does not
		# promise another event once it appears (a pppoe-WAN redial destroys
		# and recreates it, measured 2026-10-18), so wait for it here.
		dpd_log "hotplug $ACTION $INTERFACE -> $DEVICE not up yet; waiting for it"
		dpd_wait_for_dev "$DEVICE" &
	else
		# Also not necessarily a failure: the lan hotplug fires before
		# dpd_fastpath.init has loaded the program, and dpdctl then fails
		# for a moment. "attach FAILED" in that window was misleading --
		# the filter appears a second later and nothing is broken. Retry
		# briefly and describe the race honestly if it still does not
		# attach; the init and the next ifup are the real retries.
		tries=0
		attached=0
		while [ "$tries" -lt 3 ]; do
			sleep 1
			tries=$((tries + 1))
			if dpd_attach_if "$DEVICE"; then
				attached=1
				break
			fi
		done
		if [ "$attached" = 1 ]; then
			dpd_push_config
			dpd_log "hotplug $ACTION $INTERFACE -> $DEVICE attached after ${tries}s (racing the init)"
		else
			dpd_log "hotplug $ACTION $INTERFACE -> $DEVICE attach deferred (program not ready); the init and the next ifup retry"
		fi
	fi
	;;
ifdown|remove)
	[ -n "$DEVICE" ] || exit 0
	dpd_detach_if "$DEVICE"
	dpd_bump_epoch
	dpd_log "hotplug $ACTION $INTERFACE -> $DEVICE detached"
	;;
esac

exit 0
