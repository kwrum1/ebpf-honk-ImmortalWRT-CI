config global 'global'
	# Off by default: a single-WAN box must behave exactly as before until the
	# operator (or the LuCI page) turns multi-WAN on.
	option enabled '0'
	option health_interval '5'
	# auto   -> weight = bandwidth / slowest uplink (1..8)
	# manual -> use the per-WAN `weight` below
	option mode 'auto'

# One section per uplink. `interface` is the netifd interface (wan, wan2, ...);
# the device is resolved at runtime, so PPPoE works without naming pppoe-wan.
#
# `bandwidth` is the downlink capacity in Mbit/s, used by mode=auto only. With
# 100 and 50 the effective weights are 2 and 1, i.e. two thirds / one third of
# new flows. `weight` (1..8) is used by mode=manual.
#
#config wan 'wan'
#	option interface 'wan'
#	option bandwidth '100'
#	option weight '1'
#	option enabled '1'
#	option health '1.1.1.1'
#
#config wan 'wan2'
#	option interface 'wan2'
#	option bandwidth '50'
#	option weight '1'
#	option enabled '1'
#	option health '1.1.1.1'
