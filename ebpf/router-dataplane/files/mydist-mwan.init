#!/bin/sh /etc/rc.common
# mydist: multi-WAN load balancing (routing tables, fwmark rules, dpd_wans).
#
# Starts after einat (START=60) because reconcile needs the uplink devices to
# exist and their TCX links to be up: it is einat's restart that drops the
# classic dpd filters on the same netdev, and this service is what puts them
# back.

START=61
STOP=05
USE_PROCD=1

PROG=/usr/libexec/mydist-mwan

start_service() {
	$PROG reconcile

	procd_open_instance health
	procd_set_param command "$PROG" health
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# A reload after a network event must re-read netifd state (new gateway, a
# PPPoE link that finally dialled) and rewrite the tables/rules/map. The health
# loop deliberately keeps running: killing it would drop the up/down bits.
reload_service() {
	$PROG reconcile
}

stop_service() {
	$PROG cleanup
}

service_triggers() {
	procd_add_reload_trigger "mydist_mwan" "network"
	procd_add_interface_trigger "interface.*" wan /etc/init.d/mydist-mwan reload
	procd_add_interface_trigger "interface.*" wan2 /etc/init.d/mydist-mwan reload
	procd_add_interface_trigger "interface.*" wan3 /etc/init.d/mydist-mwan reload
}
