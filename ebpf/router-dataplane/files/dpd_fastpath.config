# SPDX-License-Identifier: GPL-2.0-only
#
# ebpf router-dataplane defaults.
#
# The accelerator is on by default, and it can be, because of one measured
# kernel fact: the transparent proxy (honk) owns TCX and sch_handle_ingress()
# runs tcx_run() before tc_run(). Every classic filter -- this one included --
# therefore sees only what the proxy already declined. dpd is structurally
# BEHIND honk, so "accelerate the rest" cannot starve the proxy, and no pref
# juggling is involved. dpd must stay a classic filter for that to hold.
#
# The other half is the return path. Taking a flow over skips netfilter, so its
# reply exists only because einat is the NAT (conntrack-free, on the WAN's TCX
# hooks) and its init hands fw4 a blanket WAN->LAN accept. That is why
# acceleration is *gated on einat being attached*: without it the mode is
# downgraded to observe at boot and every reason is logged. IPv6 is never
# accelerated for the same reason (no NAT66 in this baseline, so the reply would
# be untracked and fw4 would reject it).
#
# honk coexistence: the stock core returns TC_ACT_OK for direct flows, which
# skips the classic chain, so dpd stays in observe while the proxy runs. The
# honk p1 core (ci/patches/honk-direct-unspec.py) hands direct flows back with
# TC_ACT_UNSPEC and marks the install with /usr/share/honk/direct-unspec; with
# that marker dpd keeps accelerating direct traffic while proxy/block verdicts
# stay terminal in honk. No honk source fork: the patch lives in the package.
#
# Set mode=off to make the program inert without detaching it.

config dpd 'global'
	# load the program and put it on the selected interfaces' ingress hook.
	# With this off, no maps exist and dpdctl has nothing to talk to.
	option attach '1'

	# killer switch read by the BPF program itself (dpd_cfg.enable).
	# 0 makes the program return TC_ACT_UNSPEC for everything, instantly.
	option enabled '1'

	# off         - attached, inert
	# observe     - does the FIB lookup and counts, never touches a packet
	# stateless   - every forwardable packet: decrement TTL, redirect
	# stateful    - learn on the first packet, redirect subsequent ones (default)
	# neigh-probe - #14 bring-up probe for bpf_redirect_neigh()
	#
	# stateful is the default since 2026-10-27, for two reasons that point the
	# same way:
	#   * it is the cheaper per-packet path. A hit is a flow-table lookup + TTL +
	#     checksum + bpf_redirect(); stateless re-runs bpf_fib_lookup() for every
	#     packet. Measured on the bench: stateful 4.6-5.0 Gbit/s vs stateless
	#     4.3-4.9 (upload, -P4), i.e. no worse and less work per packet.
	#   * `option downlink` (below) is only allowed in this mode: with
	#     stateless the first WAN->LAN packet of a flow would also skip
	#     netfilter, including the SYN that mangle_forward clamps the MSS on.
	#
	# These are *requests*: the gates in the init script lower the effective
	# mode whenever the environment does not support it (no einat attached,
	# something sitting after us in the classic chain, uplink in the list).
	option mode 'stateful'

	# auto  - plain Ethernet egress: write the L2 header bpf_fib_lookup() already
	#         produced (dmac = neighbour, smac = egress dev_addr) and
	#         bpf_redirect(), which skips the route + neighbour lookup that
	#         bpf_redirect_neigh() would repeat for every packet. Falls back to
	#         bpf_redirect_neigh() on ppp/tunnels, stacked (VLAN/veth) devices
	#         and tagged frames, and to bpf_redirect() on NOARP/ppp.
	# neigh - always redirect_neigh() (the pre-ABI-6 per-packet lookup; escape hatch)
	# dev   - always bpf_redirect(ifindex, 0), L2 header untouched
	option redirect 'auto'

	# how long a learned flow stays usable, in ms (stateful mode only)
	option flow_ttl_ms '5000'

	# Refresh a flow's timestamp at most once per this many ms (0 = every
	# packet). The hit path writes the 32-bit last_seen field only when this
	# window has passed, which removes a dirty cache-line write per packet on
	# the hot path. A non-zero value lets an idle entry live up to this much
	# longer than flow_ttl_ms -- the error is always "cached too long", never
	# "a live flow was dropped", and 250 ms against a 5 s TTL is noise.
	option flow_refresh_ms '250'

	# Which packets we are allowed to take over.
	#   allow_all  - every IPv4 forwarding packet  (default)
	#   vlans_only - only VLAN ids in the `vlans` list below; untagged traffic is
	#                never eligible (fail-closed). Use this on a box with several
	#                LAN segments/zones, where accelerating between them would
	#                skip inter-zone firewall rules.
	option policy 'allow_all'

	# Accelerate IPv6 TCP/UDP, both directions. Default 1 on the eBPF images.
	#
	# Scope: outbound-initiated flows only (inbound v6 connections stay on the
	# stack, like v4 where einat drops the unsolicited SYN). Refused: non
	# TCP/UDP, extension headers, fragments, multicast, link-local, ::, :53,
	# DHCPv6 546/547, hop_limit <= 1, and tagged frames.
	#
	# Both directions are accelerated without a WAN-side FIB lookup: when the
	# forward flow is learned, the reverse entry is seeded from the very frame
	# that is being forwarded (dmac = its source MAC, smac = its destination
	# MAC, ingress = its egress device). The reverse entry starts unprimed, so
	# its first packet still reaches conntrack.
	#
	# Turn it off (`option ipv6 '0'` + restart) on a box whose v6 setup is
	# unusual: 6rd/6to4, a v6-in-v6 tunnel, or policy routing that changes the
	# egress after the first packet. Verify what happened with
	#   dpdctl show | grep ipv6
	#   dpdctl stats | grep -E 'v6_ok|v6_skip'
	option ipv6 '1'

	# VLAN ids for policy=vlans_only, e.g.
	#	list vlans '10'
	#	list vlans '20'
	# The list is rebuilt from this file on every start; an empty list combined
	# with vlans_only therefore accelerates nothing.

	# netifd logical interfaces (or raw device names) to attach to.
	#
	# LAN-side only, on purpose. Accelerating on the uplink would skip
	# router-acl's nft guard and the input path for router-destined packets --
	# the uplink's inbound policy belongs to router-acl + fw4, not to us. A
	# device named here that turns out to be the uplink is skipped, with one
	# exception: `option downlink '1'` + `mode=stateful` attaches it on purpose,
	# through dpd_reconcile_uplink() (see the bottom of this file).
	#
	# The hook layout (measured, see src/dpd_common.h) is:
	#   br-lan ingress: honk TCX lan_ingress_l2  -> us (pref 100)
	#   eth0  ingress : honk TCX lan_ingress_l2  -> us (pref 100)
	#   eth1  ingress : honk TCX + einat TCX + router-acl (pref 90) -> us only
	#                   when downlink=1
	list interfaces 'lan'

	# Accelerate the return direction too: attach the object to the *uplink's*
	# ingress hook as well, so WAN->LAN packets of an already-learned flow are
	# redirected to the LAN instead of walking netfilter.
	#
	# On by default since 2026-10-27, but only ever effective with
	# mode=stateful (the init and the iface hotplug refuse downlink=1 with any
	# other mode and say so in the log). The first packets of every flow --
	# both directions -- still traverse netfilter, so conntrack is created,
	# fw4's forward chain and mangle_forward see the flow start, and
	# router-destined traffic is untouched.
	#
	# Measured on the bench (2 vCPU x86_64, -P4 iperf3, n=3 interleaved):
	#   download  2931 -> 3410 Mbit/s (+16%) at the same CPU (64% -> 66%)
	#   upload    4921 -> 5233 Mbit/s (+6%, the peer's ACKs are accelerated too)
	#   netfilter forward hook: 148302 -> 6 skbs for a 9 s download, i.e. the
	#   whole bulk leaves netfilter; fw4's WAN->LAN counters see 1 packet
	#   (53 bytes) per flow.
	#
	# What it costs, and the boundary this option draws:
	#   * packets of an accelerated flow no longer update conntrack accounting,
	#     never hit fw4's forward chain (including any user rule placed there
	#     and fw4's per-zone counters), and skip mangle_forward. nft `limit`,
	#     per-flow `counter` and dynamic blocklists therefore only see the first
	#     packets of a flow.
	#   * einat's TCX programs on the uplink still see every packet (they run
	#     before any classic filter), and router-acl is at pref 90, i.e. also
	#     ahead of us -- ACL and NAT are unaffected.
	#   * inbound *new* connections cannot be affected at all: einat's
	#     ingress_rev_snat drops WAN->LAN packets it has no mapping for before
	#     netfilter even runs (measured: with einat attached not one packet of a
	#     SYN to a LAN host reached the prerouting hook; with einat stopped the
	#     same SYN was forwarded). So this hook can only ever accelerate the
	#     return half of a flow einat already SNATed.
	#   * when the fastpath stops mid-flow (restart, watchdog, mode change) the
	#     packets simply re-enter netfilter; measured: a 34 s download survived
	#     mode=off at t=10 s with 11 retransmits and no stall, because einat
	#     rewrites before netfilter and fw4 has its blanket WAN->LAN accept.
	# Set to 0 on a box that needs per-packet nft accounting of the download
	# direction (traffic quotas done with nft counters, per-flow rate limits).
	option downlink '1'
