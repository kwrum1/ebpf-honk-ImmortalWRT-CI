config dpd_napi 'main'
	# Low-latency by default; adaptive switches to the throughput values
	# below only while the box is CPU-bound.
	#   low        gro_flush/defer=0, budget 300, dev_weight 64, no RPS/XPS
	#   throughput the values below
	#   adaptive   start low; >60% CPU for 3x10s -> throughput;
	#              <25% for 6x10s -> low (hysteresis)
	option enabled '1'
	option mode 'adaptive'
	# Throughput profile (also the one-shot values for mode=throughput).
	option netdev_budget '1000'
	option netdev_budget_usecs '8000'
	option dev_weight '128'
	# per-NAPI, applied through netdev generic netlink when the helper is
	# present and netdev_genl is 1
	option netdev_genl '1'
	option gro_flush_timeout '20000'
	option napi_defer_hard_irqs '2'
	# empty = leave the kernel/driver default alone
	option irq_suspend_timeout ''
	option threaded ''
	# Throughput profile only; the low profile writes 0 (off).
	option rps_cpus 'f'
	option xps_cpus 'f'
	# ---- optional system tuning ----------------------------------------
	# CPU list for the data-device NAPI IRQs (smp_affinity_list), e.g. '2-3'
	# or '4'. Empty = leave IRQ affinity alone.
	option irq_cpus ''
	# keep = change nothing; off = root noqueue (mq fallback);
	# cake = root cake; hybrid = LAN noqueue + WAN cake.
	option qdisc_mode 'keep'
	# Extra arguments for `tc qdisc ... root cake`. Empty = unshaped cake.
	option qdisc_cake_args ''
