#!/bin/sh
# ebpf router-dns: SmartDNS is the only resolver (port 53); dnsmasq keeps no
# DNS role at all. Runs once, on the first boot after flashing.
#
# This is the same state ebpf-posture enforces at every boot (S26): smartdns
# 53, dnsmasq port 0. The uci-defaults just makes the first boot *before* S26
# consistent, so a boot that never reaches S26 cannot leave dnsmasq holding :53.
#
# /etc/init.d/router-dns still patches /etc/dnsmasq.conf with a forward to
# 127.0.0.1:6053; that file is simply unused while dnsmasq is off. Do not "fix"
# it by moving smartdns back to 6053 -- port 53 is the shipped design.

CONF=/etc/config/smartdns

log() { logger -t router-dns "$@"; }

if [ ! -f "$CONF" ]; then
	log "$CONF is missing (smartdns not installed?); nothing done"
	exit 0
fi

# smartdns reads one @smartdns[0] section. Make sure it exists before setting
# options on it.
if ! uci -q get smartdns.@smartdns[0].enabled >/dev/null 2>&1; then
	uci -q add smartdns smartdns >/dev/null 2>&1
fi

uci -q set smartdns.@smartdns[0].enabled='1'
# 53: smartdns is the only resolver. dnsmasq is not a DNS front end here --
# odhcpd owns DHCP and the LAN names are not needed by the shipped UI.
uci -q set smartdns.@smartdns[0].port='53'
# Load-bearing. Left at its default of 1, smartdns's own init rewrites
# /etc/config/dhcp. This distribution does not let a package rewrite the base
# config, so smartdns stays off the dhcp config and we set dnsmasq ourselves.
uci -q set smartdns.@smartdns[0].auto_set_dnsmasq='0'

# dnsmasq keeps no DNS role: port 0 means "listen nowhere" even if procd
# respawns it (ebpf-posture also stops and disables it at S26).
uci -q set dhcp.@dnsmasq[0].port='0'
uci -q set dhcp.@dnsmasq[0].noresolv='1'

# Lease events must reach SmartDNS. The stock trigger only SIGHUPs dnsmasq,
# which is not the resolver here, so `<dhcp-client>.lan` answered NXDOMAIN even
# though odhcpd had published the name in /tmp/hosts. Our trigger rebuilds
# SmartDNS's hosts/address files (idempotent, writes only on change).
uci -q set dhcp.odhcpd.leasetrigger='/usr/libexec/router-dns-lease'
uci -q commit dhcp

# Upstreams are shipped as custom.conf: Chinese domains over AliDNS/DNSPod
# DoH, everything else over Cloudflare/Google DoH, with dual-stack IP
# selection. Copy it over the package template (the file is a conffile, so a
# kept config from an older image would otherwise survive forever).
if [ -f /usr/share/router-dns/smartdns-custom.conf ]; then
	cp -f /usr/share/router-dns/smartdns-custom.conf /etc/smartdns/custom.conf
fi

# Drop the server sections older images created (DoT and DHCP-derived): with
# custom.conf carrying the DoH groups, any leftover default-group server would
# race them, and the DHCP one may be a plaintext resolver.
while :; do
	s=$(uci -q show smartdns | sed -n 's/^smartdns\.\([^=]*\)=server$/\1/p' | head -1)
	[ -n "$s" ] || break
	uci -q delete "smartdns.$s"
done
# Let smartdns keep its default (yes) instead of writing "no".
uci -q set smartdns.@smartdns[0].dualstack_ip_selection='1'

# WAN must not inject plaintext resolvers into the upstream pool.
uci -q set network.wan.peerdns='0'
uci -q set network.wan6.peerdns='0'
uci -q commit network

# Retire the dnsmasq-front handover: a `/lan/` upstream on 127.0.0.1:6053 that
# nothing listens on any more (dnsmasq has port 0). Kept out of every config
# that still carries it, so `.lan` lookups stop waiting for a dead port.
for s in $(uci -q get smartdns.@smartdns[0].server 2>/dev/null); do
	case "$s" in
	*/127.0.0.1:6053|127.0.0.1:6053) uci -q del_list "smartdns.@smartdns[0].server=$s" ;;
	esac
done

uci -q commit smartdns

# The image ships a snapshot of the CN domain list; refresh it weekly when the
# device has a WAN (the updater keeps the old list on any failure).
CRON=/etc/crontabs/root
[ -f "$CRON" ] || : > "$CRON"
grep -q router-dns-cn-update "$CRON" 2>/dev/null ||
	echo '0 4 * * 1 /usr/libexec/router-dns-cn-update' >> "$CRON"

# The package ships the init script but does not enable it.
/etc/init.d/smartdns enable >/dev/null 2>&1
# /etc/init.d/router-dns patches the dnsmasq forward at every boot (START=18).
/etc/init.d/router-dns enable >/dev/null 2>&1

log "smartdns enabled on 127.0.0.1:53; dnsmasq keeps no DNS role (port 0)"

exit 0
