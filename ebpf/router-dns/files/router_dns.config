# mydist router-dns: where the resolver's own upstream queries go.
#
# This file only affects SmartDNS's *outbound* queries (plain DNS, DoT and DoH --
# they are all the same sockets). It does not touch the LAN-facing side: dnsmasq
# still owns :53 and forwards to SmartDNS on 127.0.0.1:6053.
#
# egress:
#   ''        use the main routing table (the normal WAN). This is the default and
#             the clean revert: the policy rule is removed when the service starts.
#   'wg0'     a device name: a default route via that device is installed in
#             egress_table and one `ip rule fwmark` points at it.
#   'wan2'    a logical interface name (netifd is asked for its device first).
#
# Why a mark: SmartDNS's own init has `option set_mark`, which it passes to
# smartdns as `-set-mark`; the upstream sockets then carry SO_MARK and the single
# policy rule decides the egress. No nft, no packet rewriting, and it covers DoH
# exactly like plain DNS because the transport is the same socket.
#
# Caveat: replies of a marked flow may arrive on a different interface than its
# route. router-tuning sets net.ipv4.conf.all.rp_filter=0, which is what makes
# that work; with strict rp_filter the replies would be dropped.
#
# Example: send DNS/DoH through WireGuard
#   uci set router_dns.dns.egress='wg0'
#   uci commit router_dns && /etc/init.d/router-dns restart
#   # verify: ip rule | grep 6053 ; ip route show table 6053
#
# Example: back to the normal WAN
#   uci set router_dns.dns.egress=''
#   uci commit router_dns && /etc/init.d/router-dns restart

config router_dns 'dns'
	option egress ''
	# Next hop for the egress device. Empty means: reuse the main table's next hop
	# when it already leaves via that device (correct for a second WAN); tunnels
	# (WireGuard, tun) need none and are installed as default dev <x>.
	option egress_gateway ''
	option egress_mark '24659'
	option egress_table '6053'
