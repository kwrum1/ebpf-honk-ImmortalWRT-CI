#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# 88-router-dns-egress -- (re)apply the DNS/DoH egress when its device appears.
#
# Why this exists: /etc/init.d/router-dns has to start at 18, before dnsmasq (19),
# because it writes the dnsmasq forward. But at 18 the egress device may not exist
# yet -- a WireGuard interface, a second WAN, a macvlan -- so the policy route
# cannot be installed and the resolver would stay on the main table for the whole
# boot. The iface event for that device is the reliable moment.
#
# Idempotent: router-dns's egress_apply() removes the rule and flushes the table
# before installing them again, and nothing else here touches state.

[ -f /etc/config/router_dns ] || exit 0
[ -n "$ACTION" ] || exit 0

. /lib/functions.sh
config_load router_dns
config_get egress dns egress ''
[ -n "$egress" ] || exit 0

[ "$INTERFACE" = "$egress" ] && { /etc/init.d/router-dns restart >/dev/null 2>&1; exit 0; }
[ "$DEVICE" = "$egress" ] && { /etc/init.d/router-dns restart >/dev/null 2>&1; exit 0; }
exit 0
