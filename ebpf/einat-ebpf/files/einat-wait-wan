#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# einat-wait-wan -- wait (as a supervised process) for the external device.
#
# Why this is a procd instance and not `einat_wait_for_wan &` from start_service
# -----------------------------------------------------------------------------
# Measured 2026-10-18 (QEMU, PPPoE WAN): the first version forked a waiter out of
# start_service and then returned 1 ("no external device yet"). procd treats a
# failed start as a failed instance and tears its cgroup down -- which killed the
# waiter before the link ever dialled. The boot log then read
#
#   einat: no external device yet (WAN down?); a watcher will attach it when the link appears
#
# and nothing else, ever: no attach, no masquerade override, no NAT.
#
# As a procd instance the waiter is supervised rather than orphaned: it keeps
# running while the WAN is down, and when the device appears it restarts the
# service (which finds the device and attaches). A pppoe redial destroys and
# recreates the device, so "wait for a device" has to be a first-class state, not
# an error path.
#
# $1 = address family (4 or 6). Bounded: EINAT_WAIT_TRIES * EINAT_WAIT_INTERVAL
# (default 60*5 = 5 min), after which it logs once and exits; the iface hotplug
# still covers anything later.
. /lib/functions.sh
. /lib/functions/network.sh

FAM="${1:-4}"
IV="${EINAT_WAIT_INTERVAL:-5}"
TRIES="${EINAT_WAIT_TRIES:-60}"
case "$IV" in '' | *[!0-9]*) IV=5 ;; esac
case "$TRIES" in '' | *[!0-9]*) TRIES=60 ;; esac

DEF_WAN="$(uci -q get network.wan.ifname)"
DEF_WAN6="$(uci -q get network.wan6.ifname)"

# The same four-step resolution as the init, kept in one file so the two cannot
# drift: netifd's default-route interface, the configured section names, the
# conventional names, and finally "whichever interface holds a gateway right now"
# (the only one that is a fact rather than a name).
wan_dev() {
	local w dev i gw

	# 1. the interface the kernel actually uses for the IPv4 default route: no
	#    daemon, no jsonfilter, and a fact rather than a name. This is tried
	#    FIRST because it is the only step that cannot come back empty for the
	#    wrong reason. Measured 2026-10-18 on a PPPoE boot: inside procd's
	#    environment every ubus lookup below answered "nothing" while `ip route`
	#    was correct, so the waiter sat there and einat attached only when the
	#    link happened to redial.
	if [ "$FAM" != 6 ]; then
		dev=$(awk '$2 == "00000000" && $4 == "0003" { print $1; exit }' /proc/net/route 2>/dev/null)
		[ -n "$dev" ] && [ -e "/sys/class/net/$dev" ] && { printf '%s' "$dev"; return 0; }
	fi

	if [ "$FAM" = 6 ]; then
		network_find_wan6 w true
		w="${w:-$DEF_WAN6}"
	else
		network_find_wan w true
		w="${w:-$DEF_WAN}"
	fi
	for i in $w "$(uci -q get network.wan.interface)" wan \
		"$(uci -q get network.wan6.interface)" wan6 wan_6; do
		[ -n "$i" ] || continue
		[ "$FAM" = 6 ] || case "$i" in wan6 | wan_6) continue ;; esac
		dev=""
		network_get_device dev "$i"
		[ -n "$dev" ] && [ -e "/sys/class/net/$dev" ] && { printf '%s' "$dev"; return 0; }
	done
	for i in $(ubus list 'network.interface.*' 2>/dev/null |
		sed 's/^network\.interface\.//'); do
		case "$i" in *.*) continue ;; esac
		dev=""
		network_get_device dev "$i" || continue
		[ -n "$dev" ] && [ -e "/sys/class/net/$dev" ] || continue
		gw=""
		if [ "$FAM" = 6 ]; then
			network_get_gateway6 gw "$i"
		else
			network_get_gateway gw "$i"
		fi
		[ -n "$gw" ] && { printf '%s' "$dev"; return 0; }
	done

	# Last resort, and the only step that needs no daemon at all: the interface
	# that carries the IPv4 default route, straight from the kernel.
	#
	# Match on Destination AND Mask being zero, NOT on the RTF_GATEWAY flag: a
	# ppp default route is installed without RTF_GATEWAY (it is a point-to-point
	# link, there is no gateway on the wire), so `$4 == "0003"` matched nothing
	# and this fallback was dead code on exactly the WAN type it was written for
	# (measured 2026-10-18: /proc/net/route printed an empty result on a PPPoE
	# box whose `ip route` said `default via 10.9.9.2 dev pppoe-wan`).
	if [ "$FAM" != 6 ]; then
		dev=$(awk '$2 == "00000000" && $8 == "00000000" { print $1; exit }' /proc/net/route 2>/dev/null)
		[ -n "$dev" ] && [ -e "/sys/class/net/$dev" ] && { printf '%s' "$dev"; return 0; }
	fi
	return 1
}

i=0
# procd stops an instance by signalling it and then removing its cgroup. A
# bare `sleep "$IV"` is a separate child: when TERM reaches the shell, the
# sleep is still in the cgroup and procd warns
#
#   failed to remove busy cgroup of einat::wait-wan
#
# on every stop/reload. Run the sleep as a child we can reap ourselves and take
# it down from the TERM trap, so the cgroup is empty by the time the shell exits.
EINAT_WAIT_TERM=0
EINAT_WAIT_SLEEP=
einat_wait_stop() {
	EINAT_WAIT_TERM=1
	[ -n "$EINAT_WAIT_SLEEP" ] && kill "$EINAT_WAIT_SLEEP" 2>/dev/null
}
trap einat_wait_stop TERM INT

while [ "$i" -lt "$TRIES" ]; do
	sleep "$IV" &
	EINAT_WAIT_SLEEP=$!
	wait "$EINAT_WAIT_SLEEP" 2>/dev/null
	EINAT_WAIT_SLEEP=
	[ "$EINAT_WAIT_TERM" = 1 ] && exit 0
	i=$((i + 1))
	dev="$(wan_dev)"
	if [ -n "$dev" ]; then
		logger -t einat "external device appeared after $((i * IV))s ($dev); asking procd to reload us"
		# Trigger the reload THROUGH procd instead of calling the init script:
		# the init script's stop phase tears this instance's cgroup down, which
		# would kill the very process that is waiting for the restart to finish
		# (the same cgroup trap that killed the forked version of this waiter).
		# procd orchestrates the reload, so our death cannot abort it.
		ubus call service event '{"type":"config.change","package":"network"}' >/dev/null 2>&1 ||
			/etc/init.d/einat restart
		exit 0
	fi
done
logger -t einat "still no external device after $((TRIES * IV))s; NAT stays with fw4 masquerade for this boot (the iface hotplug still covers a later dial)"
exit 0
