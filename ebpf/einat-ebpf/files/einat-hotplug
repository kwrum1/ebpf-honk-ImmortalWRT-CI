#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# ebpf: einat -- start/refresh the eBPF NAT when the WAN actually exists.
#
# Two measured reasons this file has to exist (工作计划.md §13.18):
#
#  1. The external device is often absent when procd starts the service. That is
#     the normal case for pppoe-wan: it does not exist until the link dials.
#     start_service() then logs "no external device yet" and returns -- and
#     nothing ever retries, because ifup is NOT a procd "network reload", which
#     is the only trigger the init declares. The service would report disabled
#     while the user believes NAT is being handled by eBPF.
#
#  2. fw4 only reads einat's procd firewall overrides when fw4 itself reloads,
#     and fw4 starts at START=19 while einat starts at START=60. So on a boot
#     with einat enabled the overrides are registered *after* the ruleset was
#     built. Masquerading would stay on, and einat rewriting on the TC hook
#     while conntrack also rewrites the return path is exactly what destroys
#     full cone. (The init also schedules a reload for the boot case; this hook
#     covers the case where the WAN appears later.)
#
# ACTION values are netifd's: ifup / ifdown / ifupdate, plus add / update for
# section changes. Same convention as the datapath hook next door.
#
# Nothing here edits /etc/config/firewall: the override travels as procd data
# and fw4 merges it, which is the whole point of the design.

. /lib/functions.sh
. /lib/functions/network.sh

[ -n "$ACTION" ] || exit 0
[ -f /etc/config/einat ] || exit 0

config_load einat
config_get_bool EINAT_ENABLED config enabled 0
config_get EINAT_IFNAME config ifname ''
config_get_bool EINAT_NAT66 config nat66 0

[ "$EINAT_ENABLED" = "1" ] || exit 0

network_find_wan  EINAT_WAN4 true
network_find_wan6 EINAT_WAN6 true

# Is this event about our external interface?
#
# Do NOT decide this on network_find_wan() alone. Measured 2026-10-18 in QEMU:
# the iface hotplug for `ifup wan -> pppoe-wan` fired at an instant when
# network_find_wan() still returned nothing (netifd mid-transition), so einat
# matched nothing, exited silently, and the box kept masquerading switched off
# with no NAT until the link happened to redial. The dpd hotplug, which matches
# on names from uci/config rather than on the default route, saw the same event
# correctly -- that is the difference being copied here.
einat_is_wan() {
	local w gw

	# 1. the device einat.config.ifname pins explicitly
	[ -n "$EINAT_IFNAME" ] && [ -n "$DEVICE" ] && [ "$DEVICE" = "$EINAT_IFNAME" ] && return 0

	# 2. the logical name netifd currently calls the WAN
	if [ "$EINAT_NAT66" = "1" ]; then
		w="$EINAT_WAN6"
	else
		w="$EINAT_WAN4"
	fi
	[ -n "$w" ] && [ "$INTERFACE" = "$w" ] && return 0

	# 3. the configured section names, and the conventional ones: these do not
	#    depend on a default route existing yet. Multi-WAN: wan, wan2, wan3...
	for w in "$(uci -q get network.wan.interface)" wan; do
		[ -n "$w" ] && [ "$INTERFACE" = "$w" ] && return 0
	done
	case "$INTERFACE" in
	wan | wan[0-9]*) return 0 ;;
	esac
	for w in $(uci -q get einat.@config[0].wans 2>/dev/null); do
		[ -n "$w" ] && [ "$INTERFACE" = "$w" ] && return 0
	done
	if [ "$EINAT_NAT66" = "1" ]; then
		for w in "$(uci -q get network.wan6.interface)" wan6 wan_6; do
			[ -n "$w" ] && [ "$INTERFACE" = "$w" ] && return 0
		done
	fi

	# 4. an interface that now carries a default route IS the WAN, whatever it
	#    is called (this is the signal that was missing above)
	if [ -n "$INTERFACE" ]; then
		gw=""
		network_get_gateway gw "$INTERFACE"
		if [ "$EINAT_NAT66" = "1" ]; then
			gw=""
			network_get_gateway6 gw "$INTERFACE"
		fi
		[ -n "$gw" ] && return 0
	fi
	return 1
}

einat_log() {
	logger -t einat "$*"
}

case "$ACTION" in
ifup|ifupdate|add|update)
	einat_is_wan || exit 0

	# Restart rather than start: on an ifupdate the device may have changed
	# address or been recreated (PPPoE redial), and einat takes the external
	# address at start time.
	einat_log "hotplug $ACTION $INTERFACE -> $DEVICE: restarting"
	/etc/init.d/einat restart

	# Only reload the firewall if the service actually came up -- otherwise
	# there is nothing registered for fw4 to pick up.
	sleep 2
	if pgrep -f /usr/bin/einat >/dev/null 2>&1; then
		einat_log "reloading firewall so the nat/accept overrides are picked up"
		fw4 -q reload
	else
		einat_log "service did not come up; not reloading the firewall"
	fi
	;;
ifdown|remove)
	einat_is_wan || exit 0
	# A PPPoE redial is ifdown followed by ifup within seconds, and the measured
	# failure mode of stopping on ifdown was a box with masquerade switched back
	# on and no NAT until the next event -- or no event at all. `restart` is the
	# honest answer for both cases: with a device still there it re-attaches
	# (the device may have been recreated with a new address), and with no device
	# start_service supervises a waiter instead of failing (see
	# /usr/libexec/einat-wait-wan).
	einat_log "hotplug $ACTION $INTERFACE -> $DEVICE: restarting (attach, or wait for the dial)"
	/etc/init.d/einat restart
	;;
esac

exit 0
