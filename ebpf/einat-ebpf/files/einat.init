#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# mydist: einat (eBPF endpoint-independent / full-cone NAT) as a service.
#
# Three things about this script are deliberate:
#
#  0. It proves itself. `einat_verify` runs after the masquerade-off override
#     has been handed to fw4 and takes the service back down if einat's TCX
#     links never turn up, so the box falls back to fw4's masquerade instead of
#     being left with no NAT at all. See the comment on that function.
#
#  1. Hook ordering. einat attaches with a bpf_link on the EXTERNAL interface's
#     TC hooks (TCX ingress + egress -- NOT a pref-1 cls_bpf filter; measured,
#     see 工作计划.md §13.16) and never returns TC_ACT_OK (UNSPEC for packets it
#     did not claim). Our own program (router-dataplane) attaches as a classic
#     cls_bpf filter at pref 100 on the same hook, and the kernel runs TCX
#     before cls_bpf, so einat always sees a packet first and we only get what
#     it left behind. Do not move our pref to 1 without re-reading that section.
#
#  2. Firewall rules are emitted as procd data (`procd_open_data` -> the
#     `firewall` array), which fw4 merges at start. That is how masquerading is
#     turned off without editing /etc/config/firewall -- this distribution never
#     rewrites the base uci config from a package.
#
#  3. `--bpf-log` is deliberately NOT passed: the parser accepts it but the
#     usage text does not list it, and an unknown option makes the service fail
#     to start. Same reasoning for --bpf-loader: the prebuilt binary shipped in
#     this package is the `aya` build, so `libbpf` would fail at load time.
#
# Validation is done with plain config_get instead of uci_load_validate on
# purpose: the latter's argument order is easy to get wrong and it fails
# silently, which is exactly how the datapath init script ended up logging
# "started" while attaching nothing (工作计划.md §13.9). A bad value here shows
# up as einat's own parse error plus procd's respawn throttle.
#
# MSS clamping for PPPoE/tunnels stays the firewall's job (option mtu_fix) and
# must remain enabled -- see 工作计划.md §8 (H2).

START=60
STOP=60
USE_PROCD=1

CONF=einat
PROG=/usr/bin/einat

. /lib/functions/network.sh

network_find_wan  DEF_WAN  true
network_find_wan6 DEF_WAN6 true

# Resolve the external device from more than one source.
#
# network_find_wan() only knows about the *default route*: at boot, before
# netifd has installed one, it returns nothing -- and inside a hotplug event it
# can still return nothing while netifd is mid-transition. Measured 2026-10-18
# in QEMU with a pppoe WAN: the dpd hotplug saw `ifup wan -> pppoe-wan` at the
# same instant einat's own hook resolved no WAN at all, so einat silently
# ignored the dial. The box had masquerading switched off and no NAT for two
# minutes, until the link happened to redial.
#
# So try, in order: what netifd currently calls the default-route interface, the
# configured section name (network.wan / network.wan6), the conventional names,
# and finally "whichever interface holds a default route right now". The last
# one is the only one that is a *fact* rather than a name.
#
# $1 = 4 or 6. Echoes the device name, or nothing (return 1).
#
# The NAT must never land on the LAN side. When it does, every flow addressed to
# the router itself gets rewritten/redirected and the box becomes unmanageable
# while ICMP still answers -- measured 2026-10-19 on the single-NIC lab VM: the
# lab set a *gateway on the LAN*, so the "default route device" fallback below
# resolved to br-lan, einat hooked it, and 22/80/443 all timed out.
einat_is_lan_dev() {
	local lan=""
	network_get_device lan lan 2>/dev/null || lan=""
	[ -n "$lan" ] && [ "$1" = "$lan" ] && return 0
	[ "$1" = "br-lan" ] && return 0
	return 1
}

# Accept a candidate only if it exists and is not the LAN. Centralised so every
# resolution path above (and below) is guarded by the same rule.
einat_emit_dev() {
	local dev="$1"
	[ -n "$dev" ] || return 1
	[ -e "/sys/class/net/$dev" ] || return 1
	if einat_is_lan_dev "$dev"; then
		logger -t einat "refusing to use $dev as the uplink: that is the LAN side"
		return 1
	fi
	echo "$dev"
	return 0
}

einat_wan_dev() {
	local fam="$1" w dev i gw

	# First, the fact: the interface the kernel uses for the IPv4 default route.
	# No ubus, no jsonfilter. Measured 2026-10-18 (PPPoE boot, inside procd's
	# environment) every ubus lookup below answered "nothing" while `ip route`
	# said `default via 10.9.9.2 dev pppoe-wan`, which is how einat ended up
	# supervising a waiter while the link was already up.
	if [ "$fam" != 6 ]; then
		dev=$(awk '$2 == "00000000" && $4 == "0003" { print $1; exit }' /proc/net/route 2>/dev/null)
		einat_emit_dev "$dev" && return 0
	fi

	if [ "$fam" = 6 ]; then
		network_find_wan6 w true
		w="${w:-$DEF_WAN6}"
	else
		network_find_wan w true
		w="${w:-$DEF_WAN}"
	fi

	for i in $w "$(uci -q get network.wan.interface)" wan \
		"$(uci -q get network.wan6.interface)" wan6 wan_6; do
		[ -n "$i" ] || continue
		[ "$fam" = 6 ] || case "$i" in wan6 | wan_6) continue ;; esac
		dev=""
		network_get_device dev "$i"
		einat_emit_dev "$dev" && return 0
	done

	for i in $(ubus list 'network.interface.*' 2>/dev/null |
		sed 's/^network\.interface\.//'); do
		case "$i" in *.*) continue ;; esac
		dev=""
		network_get_device dev "$i" || continue
		[ -n "$dev" ] && [ -e "/sys/class/net/$dev" ] || continue
		gw=""
		if [ "$fam" = 6 ]; then
			network_get_gateway6 gw "$i"
		else
			network_get_gateway gw "$i"
		fi
		[ -n "$gw" ] && einat_emit_dev "$dev" && return 0
	done

	# Last resort, no daemon involved: the interface the kernel uses for the IPv4
	# default route. Match Destination AND Mask zero -- NOT the RTF_GATEWAY flag:
	# a ppp default route carries no gateway flag (point-to-point), which is why
	# the first version of this fallback never matched on a PPPoE box while
	# `ip route` was correct.
	if [ "$fam" != 6 ]; then
		dev=$(awk '$2 == "00000000" && $8 == "00000000" { print $1; exit }' /proc/net/route 2>/dev/null)
		einat_emit_dev "$dev" && return 0
	fi
	return 1
}

# fw4 can tell us the device behind a netifd logical name; if it cannot, fall
# back to the logical name itself. Empty means "omit the firewall rules"
# rather than emitting a rule with an empty src, which fw4 would reject.
fw4_device() {
	local dev="$1" out

	[ -n "$dev" ] || return 1
	out="$(fw4 -q device "$dev" 2>/dev/null)"
	[ -n "$out" ] || out="$dev"
	echo "$out"
}

# Is einat attached to this device right now?
#
# The links it creates are TCX (bpf_link), and TCX links do NOT appear in
# `tc filter show` -- measured, 工作计划.md §13.16. So the only reliable probe
# is bpftool's link table. bpftool pads its fields, and the real output is two
# physical lines (measured in QEMU 2026-10-17):
#
#   22: tcx  prog 88
#   	ifindex eth1(3)  attach_type tcx_ingress
#
# so the separator between `ifindex eth1(3)` and `attach_type` is NOT a single
# space. The first version of this probe matched a literal one-space gap, never
# matched, and the watchdog dutifully took a *working* einat down on every boot
# (einat had both TCX links: `ingress_rev_snat` on tcx/ingress and
# `egress_snat` on tcx/egress of the WAN). Match [[:space:]]+ instead.
#
# Returns 0 attached, 1 not attached, 2 cannot tell (no bpftool). The caller
# must distinguish 2 from 1: "cannot tell" means trust the configuration, not
# "assume failure" -- a missing bpftool must never take the NAT down.
einat_attached() {
	local dev="$1"

	command -v bpftool >/dev/null 2>&1 || return 2
	bpftool link show 2>/dev/null \
		| grep -qE "ifindex ${dev}\([0-9]+\)[[:space:]]+attach_type tcx_ingress" && return 0
	# Second, independent probe: einat's own program names, as
	# `bpftool net show` prints them (measured 2026-10-17):
	#   eth1(3) tcx/ingress ingress_rev_snat prog_id 88 link_id 22
	#   eth1(3) tcx/egress  egress_snat      prog_id 89 link_id 23
	# Either probe saying "yes" is enough; only both saying "no" means unattached.
	bpftool net show 2>/dev/null | grep -qE "tcx/(ingress|egress)[[:space:]]+(ingress_rev_snat|egress_snat)" && return 0
	return 1
}

# The watchdog. Only started when the masquerade-off override was actually
# handed to fw4, i.e. when einat is supposed to be the NAT for this box.
#
# Without it the failure mode is the worst one available: einat cannot attach,
# so nothing does NAT, while fw4 has already been told to stop masquerading --
# the LAN has no internet at all, and procd keeps respawning a program that
# will never work. With it the box degrades to the stock fw4 path instead.
#
# Deliberately no uci write here: a transient failure (bpffs not mounted yet,
# a race on a slow boot) must not disable the datapath permanently. The service
# is only stopped for this boot and the next boot retries.
einat_verify() {
	local dev="$1" timeout="${2:-15}" i=0 rc

	[ "${timeout:-0}" -gt 0 ] 2>/dev/null || return 0

	while [ "$i" -lt "$timeout" ]; do
		einat_attached "$dev"
		rc=$?
		if [ "$rc" = 0 ]; then
			logger -t einat "verify: eBPF NAT confirmed on $dev"
			einat_notify_datapath
			return 0
		fi
		if [ "$rc" = 2 ]; then
			logger -t einat "verify: bpftool unavailable, cannot verify; trusting the config"
			einat_notify_datapath
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done

	logger -t einat "verify: FAILED -- no TCX link on $dev after ${timeout}s, the eBPF NAT is not running"
	logger -t einat "verify: falling back to fw4 masquerade for this boot (einat stays enabled; next boot retries)"
	# stop_service reloads fw4, which drops the injected nat/accept overrides
	# and brings the zone masquerade rule back. procd respawn is not a problem:
	# /etc/init.d/einat stop removes the instance properly.
	sleep 1
	/etc/init.d/einat stop
}

# Tell the accelerator that the NAT situation changed.
#
# router-dataplane only accelerates while einat is attached: an accelerated flow
# skips conntrack, so its reply is accepted only because of the blanket WAN->LAN
# accept that einat injects into fw4. Both directions matter -- einat confirming
# an attach may let dpd start accelerating, and einat going away must make it
# stop at once rather than eat replies. Polling would work too; this is exact,
# and it is the whole dependency between two packages that ship together.
#
# The helper is a path, not an init command, on purpose: rc.common dispatches an
# extra command by running a function of the same name, and `gate-refresh` is not
# a legal function name in every shell (dash refuses it).
einat_notify_datapath() {
	[ -x /usr/libexec/dpd-gate-refresh ] || return 0
	/usr/libexec/dpd-gate-refresh >/dev/null 2>&1 || true
}

# Wait (bounded) for the external device to come up, then restart the service.
#
# A pppoe WAN does not exist when procd starts us at S60, and a dial is an
# *ifup* -- which is NOT the procd `network` reload that service_triggers()
# waits for. The 89-einat hotplug reacts to the dial; this covers the case where
# that event is missed, arrives before the device is visible, or the link
# re-dials later. Measured 2026-10-18 in QEMU: einat said "no external device
# yet" at 02:11:01 and attached only at 02:13:19, when the link happened to
# redial -- 2m18s of a box whose masquerade had already been switched off, i.e.
# with no NAT at all. Do not leave that to luck.
#
# The wait-for-WAN loop lives in /usr/libexec/einat-wait-wan and runs as a procd
# instance (see start_service): a forked child does not survive procd tearing
# down a failed instance's cgroup, which is exactly what happened on the first
# PPPoE boot after this was added.

# Every uplink this box should NAT for.
#
# An explicit list wins: `list wans 'wan wan2'` in /etc/config/einat.
# Otherwise: the default-route device plus every netifd interface named `wan`
# or `wanN` that currently has a device. That is exactly a dual-PPPoE home
# setup: sections wan + wan2, devices pppoe-wan / pppoe-wan2 once dialled.
einat_uplinks() {
	local list i dev

	list="$(uci -q get einat.@config[0].wans 2>/dev/null)"
	if [ -n "$list" ]; then
		for i in $list; do
			dev=""
			network_get_device dev "$i" 2>/dev/null
			[ -n "$dev" ] && [ -e "/sys/class/net/$dev" ] || continue
			einat_is_lan_dev "$dev" && continue
			echo "$dev"
		done
		return 0
	fi

	dev="$(einat_wan_dev 4 2>/dev/null)"
	[ -n "$dev" ] && echo "$dev"
	for i in $(ubus list 'network.interface.*' 2>/dev/null |
		sed 's/^network\.interface\.//'); do
		case "$i" in wan | wan[0-9]*) ;; *) continue ;; esac
		dev=""
		network_get_device dev "$i" 2>/dev/null
		[ -n "$dev" ] && [ -e "/sys/class/net/$dev" ] || continue
		einat_is_lan_dev "$dev" && continue
		echo "$dev"
	done
}

# Shift "20000-29999" by index * <range width> so every instance owns a
# disjoint range (shifting by a fixed 5000 would overlap a 10000-wide range).
einat_shift_ports() {
	local base="$1" idx="$2" a b w

	a="${base%-*}"
	b="${base#*-}"
	[ "$a" != "$base" ] || { echo "$base"; return; }
	w=$((b - a + 1))
	echo "$((a + idx * w))-$((b + idx * w))"
}

einat_instance() {
	local ifname="$1" ports="$2" subnets iface landev wandev

	procd_open_instance "$ifname"
	procd_set_param command "$PROG" -i "$ifname" --ports "$ports"

	[ "$nat44" = 1 ] && procd_append_param command --nat44
	[ "$nat66" = 1 ] && procd_append_param command --nat66

	# Source NAT only these networks: the static list plus whatever the named
	# internal interfaces currently carry.
	for iface in $internal_ifaces; do
		network_get_subnets subnets "$iface"
		internal_subnets="${subnets:+$subnets }$internal_subnets"
	done
	[ -z "$internal_subnets" ] || procd_append_param command --internal $internal_subnets

	procd_append_param netdev "$ifname"

	if [ "$hairpin_enabled" = 1 ] && [ -n "$hairpinif" ]; then
		procd_append_param command --hairpin-if lo $hairpinif
		for iface in $hairpinif; do
			procd_append_param netdev "$iface"
		done
	fi

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn

	wandev="$(fw4_device "$ifname")"
	landev="$(fw4_device "${lan_iface:-lan}")"
	[ -n "$wandev" ] && [ -n "$landev" ] || \
		logger -t einat "could not resolve devices (wan='$wandev' lan='$landev') for $ifname"

	procd_close_instance
}

# fw4 overrides, emitted ONCE for the whole service: one ACCEPT per uplink and
# one masquerade-off per uplink. procd data is service-scoped, so doing this
# inside einat_instance() (once per WAN) would either duplicate or overwrite.
einat_fw_data() {
	local wandev landev

	landev="$(fw4_device "${lan_iface:-lan}")"
	[ -n "$landev" ] || { logger -t einat "no LAN device; no firewall overrides"; return 1; }

	procd_open_data
	json_add_array firewall
	for wandev in $EINAT_DEVS; do
		# einat's external port range must be reachable from outside
		json_add_object ''
		json_add_string type rule
		json_add_string target 'ACCEPT'
		json_add_string name "einat: forward $wandev to lan"
		json_add_string family 'ipv4'
		json_add_string proto 'tcp udp icmp'
		json_add_string src "$wandev"
		json_add_string dest "$landev"
		json_close_object
		# einat IS the NAT: masquerading has to go, otherwise the return
		# path gets rewritten by conntrack and full-cone is lost
		json_add_object ''
		json_add_string type nat
		json_add_string target 'ACCEPT'
		json_add_string name "einat: disable masquerade on $wandev"
		json_add_string family 'ipv4'
		json_add_string proto 'tcp udp icmp'
		json_add_string src "$wandev"
		json_close_object
	done
	json_close_array
	procd_close_data
	return 0
}

start_service() {
	local landing landev iface dev idx ports_i devs

	config_load "$CONF"
	config_get_bool enabled      config enabled 0
	config_get      nat44        config nat44 1
	config_get      nat66        config nat66 0
	config_get      ports        config ports '20000-29999'
	config_get      ifname       config ifname ''
	config_get      lan_iface    config lan_iface 'lan'
	config_get      internal_ifaces config internal_ifaces ''
	config_get      hairpin_enabled config hairpin_enabled 0
	config_get      hairpinif    config hairpinif ''
	config_get      internal_subnets config internal_subnets ''
	config_get      verify_timeout config verify_timeout 15

	if [ "$enabled" != "1" ]; then
		logger -t einat "disabled (uci: einat.config.enabled=0); not starting"
		return 0
	fi

	# A configured single `ifname` is authoritative (old behaviour, and the only
	# sane choice for nat66).
	if [ -n "$ifname" ]; then
		devs="$ifname"
	elif [ "$nat66" = 1 ]; then
		devs="$(einat_wan_dev 6)"
	else
		devs="$(einat_uplinks | awk '!seen[$0]++')"
	fi

	if [ -z "$devs" ]; then
		# Not an error: a pppoe WAN only exists after the link dials. Supervise
		# the waiter as a procd instance -- the first version forked it from here
		# and returned 1, and procd tore the failed instance's cgroup down,
		# killing the waiter before the link ever came up (measured 2026-10-18:
		# "no external device yet" and then nothing, no NAT). See
		# /usr/libexec/einat-wait-wan.
		logger -t einat "no external device yet (WAN down?); supervising a waiter until it appears"
		procd_open_instance wait-wan
		if [ "$nat66" = 1 ]; then
			procd_set_param command /usr/libexec/einat-wait-wan 6
		else
			procd_set_param command /usr/libexec/einat-wait-wan 4
		fi
		procd_set_param respawn 3600 5 0
		procd_set_param term_timeout 3
		procd_close_instance
		return 0
	fi

	network_get_device landev "$lan_iface"
	[ -n "$landev" ] || logger -t einat "no internal device resolved for '$lan_iface'"

	# One procd instance per uplink, each with its own port range.
	EINAT_DEVS=""
	idx=0
	for dev in $devs; do
		ports_i="$(einat_shift_ports "$ports" "$idx")"
		logger -t einat "starting instance $idx: ifname=$dev ports=$ports_i nat44=$nat44 hairpin=$hairpin_enabled lan=${landev:-?}"
		einat_instance "$dev" "$ports_i"
		EINAT_DEVS="$EINAT_DEVS $dev"
		idx=$((idx + 1))
	done

	# fw4 only reads the overrides when IT reloads, and it is started well before
	# us (START=19 vs 60). Reload in the background so procd is not held up, and
	# let the hotplug hook handle the case where a WAN only appears later
	# (pppoe-wan). One data block covers every uplink.
	if einat_fw_data; then
		( sleep 3; logger -t einat "reloading firewall so the nat/accept overrides are picked up"; fw4 -q reload ) &
		for dev in $EINAT_DEVS; do
			( einat_verify "$dev" "$verify_timeout" ) &
		done
	fi
}

stop_service() {
	logger -t einat "stopping"

	# Symmetry with start_service: the masquerade suppression lives in fw4's
	# *rendered ruleset*, and fw4 only re-reads the procd data when it reloads.
	# So stopping the service without a reload would leave the accept rules in
	# srcnat_wan with nothing doing NAT at all -- the LAN would simply lose the
	# internet until the next reboot or a manual `fw4 reload`. That is exactly
	# the kind of "I turned the eBPF NAT off and everything broke" trap worth
	# closing here rather than in the documentation.
	#
	# Harmless when the service was never up (nothing to restore), and it does
	# not loop: einat's reload triggers are `einat` and `network`, not
	# `firewall`.
	( sleep 2; logger -t einat "reloading firewall so masquerade comes back"; fw4 -q reload ) &

	# ... and the accelerator has to stop immediately: from this moment on fw4's
	# masquerade is the NAT again, i.e. conntrack-based, and an accelerated flow
	# has no conntrack entry to match.
	einat_notify_datapath
}

service_triggers() {
	procd_add_reload_trigger "$CONF" 'network'
}

extra_command "status" "Show whether einat is running and what it attached to" || true

status() {
	local dev

	if pgrep -f "$PROG" >/dev/null 2>&1; then
		echo "einat is running:"
		ps w | grep -a '[e]inat' | sed 's/^/  /'
	else
		echo "einat is not running"
	fi
	echo "--- uci ---"
	uci show "$CONF" 2>/dev/null | sed 's/^/  /'
	echo "--- TC hooks on the WAN (einat attaches with TCX; our datapath is pref 100) ---"
	network_get_device dev "$DEF_WAN"
	if [ -n "$dev" ]; then
		tc filter show dev "$dev" ingress 2>&1 | sed 's/^/  /'
	fi
}
