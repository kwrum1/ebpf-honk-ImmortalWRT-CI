# SPDX-License-Identifier: GPL-2.0-only
#
# ebpf: einat defaults.
#
# einat REPLACES netfilter masquerading. Enabling it therefore also makes the
# init script emit a fw4 rule that turns masquerading OFF (as procd data, so
# /etc/config/firewall is never touched). Do not run both at once.
#
# Default is ON: this baseline ships the eBPF datapath enabled, not as an
# opt-in experiment. What makes that safe is the verifier in
# /etc/init.d/einat -- after the masquerade-off override has been handed to
# fw4, it watches the WAN device's TCX links for `verify_timeout` seconds and,
# if they never appear, stops einat for that boot so `stop_service` can put the
# stock fw4 masquerade path back. The one failure mode that has to be designed
# away is "eBPF NAT did not come up, so nothing does NAT while fw4 has been
# told to stop".
#
# To turn it off (and go back to fw4 masquerade on the next firewall reload):
#   uci set einat.config.enabled='0'
#   uci commit einat
#   /etc/init.d/einat stop
#   /etc/init.d/firewall reload

config einat 'config'
	option enabled '1'

	# seconds to wait for einat's TCX links before falling back to fw4
	# masquerade for this boot. 0 disables the verifier (not recommended: with
	# it off a failed eBPF attach leaves the LAN with no NAT at all).
	option verify_timeout '15'

	# NAT44 is the whole point here. NAT66 is left off: it costs ~4x eBPF load
	# time and the plan says no NAT66 (IPv6 gets an eBPF ACL instead).
	option nat44 '1'

	# External port range handed out. 10000 ports is plenty for a home router
	# and keeps the map small.
	option ports '20000-29999'

	# External interface. LEAVE UNSET to auto-detect from the default WAN
	# (pppoe-wan / eth1 / ...). Setting it to a literal name disables
	# auto-detection and will break on PPPoE redial if you guess wrong.
	#option ifname 'pppoe-wan'

	# Source NAT only these internal networks.
	list internal_subnets '192.168.0.0/16'
	list internal_subnets '172.16.0.0/12'
	list internal_subnets '10.0.0.0/8'

	# Optional: take the internal subnets from live interfaces instead of the
	# static list above (both are merged).
	#list internal_ifaces 'lan'

	# Hairpinning: internal host -> public address of the router -> another
	# internal host. Needs the internal bridge(s) listed.
	option hairpin_enabled '1'
	list hairpinif 'br-lan'

	# fw4 device lookup for the WAN->LAN accept rule and the masquerade
	# override. Only used to print the device name; override if your LAN is not
	# on br-lan.
	option lan_iface 'lan'

	# BPF loading backend. The prebuilt binary in this package is the `aya`
	# build, so leave this unset. `libbpf` would fail.
	#option bpf_loader 'libbpf'
