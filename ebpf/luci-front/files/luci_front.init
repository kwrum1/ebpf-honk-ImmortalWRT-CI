#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# mydist / luci-front -- the public HTTP(S) side of LuCI.
#
# START is late on purpose: uhttpd (the backend that runs the Lua CGI and the
# ubus bridge) must be listening on 127.0.0.1:8080 before the front end starts,
# otherwise the first clicks after a reboot are 502s.
#
# uhttpd's own configuration is moved to loopback by /etc/uci-defaults/96-mydist-front
# on first boot. Nothing here edits /etc/config/firewall or /etc/config/dhcp: the
# front end binds the same ports uhttpd used, so the zone policy is unchanged.
START=96
STOP=04
USE_PROCD=1

. /lib/functions.sh

CONF=/var/etc/luci-front.conf

gen_conf() {
	config_load luci_front
	config_get listen_http main listen_http '0.0.0.0:80'
	config_get listen_https main listen_https '0.0.0.0:443'
	config_get cert main cert '/etc/uhttpd.crt'
	config_get key main key '/etc/uhttpd.key'
	config_get root main root '/www'
	config_get backend main backend '127.0.0.1:8080'
	config_get dynamic main dynamic '/cgi-bin/,/ubus'
	config_get_bool hsts main hsts 1

	mkdir -p /var/etc
	cat >"$CONF" <<EOC
listen_http=$listen_http
listen_https=$listen_https
cert=$cert
key=$key
root=$root
backend=$backend
dynamic=$dynamic
hsts=$hsts
EOC
}

# The front end owns :443 now, so it also owns the certificate's life cycle.
# uhttpd only gets a certificate generated when *its* HTTPS listener is enabled
# (luci-ssl's uci-default does that), and 96-mydist-front deliberately turns
# that listener off -- which on a fresh image leaves no certificate at all and
# would make this service refuse to start. Generate one instead: a router that
# advertises the front end as its only HTTPS side must be able to serve it.
front_make_cert() {
	local crt="$1" key="$2" cn
	[ -s "$crt" ] && [ -s "$key" ] && return 0
	[ -x /usr/bin/openssl ] || {
		logger -t luci-front "no $crt and no openssl; cannot create a certificate"
		return 1
	}
	cn=$(uci -q get network.lan.ipaddr)
	[ -n "$cn" ] || cn=$(hostname)
	mkdir -p "${crt%/*}" "${key%/*}"
	umask 077
	if /usr/bin/openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 7300 \
		-subj "/C=CN/O=mydist/CN=${cn}" \
		-keyout "$key" -out "$crt" >/dev/null 2>&1; then
		chmod 600 "$key"
		logger -t luci-front "generated a self-signed certificate for ${cn}"
		return 0
	fi
	logger -t luci-front "openssl could not write $crt / $key"
	return 1
}

start_service() {
	config_load luci_front
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || { logger -t luci-front "disabled by uci"; return 0; }

	gen_conf

	# A front end that cannot do TLS would take LuCI down with it, so make sure
	# there is a certificate (self-signed on a fresh image or after a reset).
	front_make_cert "$cert" "$key" || return 0
	if [ ! -r "$cert" ] || [ ! -r "$key" ]; then
		logger -t luci-front "certificate $cert / $key still unreadable; NOT starting (uhttpd still serves on loopback)"
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/luci-front "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	logger -t luci-front "front end up: $(cat "$CONF" | tr '\n' ' ')"
}

stop_service() {
	logger -t luci-front "stopping (uhttpd still answers on its loopback port)"
}
