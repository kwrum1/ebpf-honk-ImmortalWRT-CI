#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# luci-front-report -- what the front end is doing, for the mydist LuCI page and
# for a shell. Reads only.
echo "--- process ---"
if pgrep -f /usr/sbin/luci-front >/dev/null 2>&1; then
	echo "luci-front: running (pid $(pgrep -f /usr/sbin/luci-front | head -1))"
else
	echo "luci-front: not running"
fi
echo "--- listeners ---"
netstat -ln 2>/dev/null | awk '$4 ~ /:(80|443|8080)$/ { print "  " $4 }'
echo "--- config ---"
cat /var/etc/luci-front.conf 2>/dev/null | sed 's/^/  /'
echo "--- backend (uhttpd) ---"
if pgrep -f uhttpd >/dev/null 2>&1; then
	echo "  uhttpd: running (pid $(pgrep -f uhttpd | head -1))"
else
	echo "  uhttpd: not running -- the front end will return 502 for dynamic paths"
fi
echo "--- last log lines ---"
logread 2>/dev/null | grep -a 'luci-front' | tail -6
