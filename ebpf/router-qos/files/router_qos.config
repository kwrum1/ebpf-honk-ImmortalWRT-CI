# router-qos - mydist QoS
#
# On by default, no UI, no rate to tune. The scheduler is chosen automatically
# (cake diffserv4 + nat up to 1 Gbit/s, fq_codel above that or when the kernel
# has no cake module) and runs unlimited: it provides per-flow fairness and AQM,
# it does not throttle the link to a number someone typed in.
#
# There is no `upload` option on purpose. Shaping to a guessed link rate is
# worse than not shaping, and the queue that actually matters on a home uplink
# is the ISP's. See /usr/libexec/router-qos.sh for the full rationale.

config router_qos 'global'
	option enabled '1'

	# auto | throughput | latency
	#
	#   auto       pick by link rate (cake <= 1 Gbit/s, fq_codel above)
	#   throughput fq_codel always: the cheapest per-packet scheduler
	#   latency    cake always, with a shorter AQM target (rtt 10ms): lower
	#              p99 at the cost of more drops under burst
	#
	# auto is the default and the only mode that changes with the link; the
	# other two are explicit operator choices (review §6: keep the low-latency
	# profile separate instead of changing everybody's default).
	option profile 'auto'

	# netifd logical name(s), space separated: "wan", "wan wan2", ...
	# pppoe-wan works without being named here: the device is resolved at
	# runtime and the qdisc is re-applied on every ifup by
	# /etc/hotplug.d/iface/92-router-qos.
	#
	# When multi-WAN load balancing (mydist_mwan) is enabled, all of its
	# uplinks are covered automatically even if only `wan` is listed.
	option wan 'wan'
