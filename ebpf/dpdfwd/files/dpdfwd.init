#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=04

start_service() {
	local auto_tune accel tcp_ttl udp_ttl udp_unidir

	. /lib/functions.sh
	config_load dpd_fastpath
	config_get_bool auto_tune global auto_tune 1
	config_get accel global accel_after_pkts 8
	config_get tcp_ttl global tcp_ttl_ms 300000
	config_get udp_ttl global udp_ttl_ms 120000
	config_get udp_unidir global udp_unidir_ttl_ms 30000

	procd_open_instance
	procd_set_param command /usr/sbin/dpdfwd \
		--accel "$accel" --tcp-ttl "$tcp_ttl" \
		--udp-ttl "$udp_ttl" --udp-unidir "$udp_unidir"
	[ "$auto_tune" = 1 ] && procd_append_param command --auto-tune
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
