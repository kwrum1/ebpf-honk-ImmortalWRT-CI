{
	"luci-app-ebpf": {
		"description": "ebpf pages: multi-WAN configuration, firewall port control and status",
		"read": {
			"ubus": {
				"network.interface": [ "dump" ],
				"network.device": [ "status" ],
				"service": [ "list" ],
				"file": [ "read" ]
			},
			"uci": [ "ebpf_mwan", "network", "firewall" ],
			"file": {
				"/var/run/ebpf-mwan/wans": [ "read" ],
				"/tmp/run/ebpf-mwan/wans": [ "read" ]
			}
		},
		"write": {
			"uci": [ "ebpf_mwan", "firewall" ]
		}
	}
}
