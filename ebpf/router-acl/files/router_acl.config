# router-acl - ebpf WAN eBPF ACL
#
# Defaults: enabled 1 + mode guard. Unsolicited inbound on the WAN is dropped at
# the TC hook, before fw4 or conntrack see it. Purely additive -- fw4 and
# conntrack keep working, only junk disappears earlier. Note that this makes the
# shipped default *stricter* than a stock OpenWrt baseline: with einat enabled
# the fw4 ruleset contains a blanket WAN->LAN accept, so guard is what actually
# keeps unsolicited inbound out.
#
# Read /etc/init.d/router-acl for the mode semantics before changing anything.

config router_acl 'global'
	# 0 = not attached, no fw4 includes, zero behaviour change
	option enabled '1'

	# off    - attached but every packet gets TC_ACT_UNSPEC (telemetry only)
	# guard  - drop unsolicited inbound on the WAN. Additive: fw4 and
	#          conntrack keep working; only junk disappears before reaching
	#          either of them.
	# bypass - guard + mark + notrack. This is what removes nf_conntrack from
	#          the data path for NATed flows. Requires einat to be enabled;
	#          the init script refuses and falls back to guard otherwise.
	option mode 'guard'

	# netifd logical names or bare device names. The WAN device is resolved at
	# start and again on every ifup, so pppoe-wan works.
	option wan 'wan'
	option lan 'lan'

	# answer pings aimed at the router from the WAN. fw4 drops these by
	# default, so the default here matches.
	option allow_echo '0'
	option allow_v6_echo '0'

	# seconds; how long a learned mapping keeps answering for its port
	option udp_timeout '120'
	option tcp_timeout '3600'
	option icmp_timeout '30'

	# skb->mark bit written in bypass mode, and the mask the generated fw4
	# rules match it with. Keep it a single high bit.
	option mark '01000000'
	option mark_mask 'ff000000'

	# read /etc/config/firewall (read-only) and add every DNAT port forward it
	# declares to the FORWARD allow list, so switching the ACL on does not
	# silently break port forwards that already worked.
	option import_firewall '1'

	# Full cone escape hatch. OFF by default, and here is why.
	#
	# The ACL recognises a reply by its *remote endpoint* -- what we sent to
	# is exactly what the reply comes from -- because that is the only field
	# einat's SNAT/un-SNAT does not rewrite. That is exact for every flow the
	# box starts, but a genuine full cone peer that learned our mapping from
	# somewhere else does not match, and would be dropped.
	#
	# Setting this to 1 additionally accepts inbound TCP/UDP whose
	# destination is inside one of the LAN prefixes (read from the LAN
	# interface at start). That is the same posture einat's own procd data
	# takes -- it emits a blanket WAN->LAN accept -- and it restores full
	# cone. The reason it is not the default: with it on, anything able to
	# forge a LAN destination can inject into the LAN, because by the time
	# the packet reaches TC, einat has already un-SNATed it and there is no
	# way left to tell "einat did this" from "somebody wrote a LAN address
	# in the header". Seeing it before einat's un-SNAT would need an XDP
	# hook, which this baseline deliberately does not use.
	option fullcone '0'

	# Explicit allow list. Nothing is listed by default, which matches fw4's
	# default of dropping everything unsolicited.
	#
	#   [family:]proto[/port]     family defaults to 4
	#   proto is tcp, udp, icmp, icmpv6 or a number
	#   no port means "every port of this protocol"
	#
	# list forward 'tcp/8080'      inbound towards a LAN host
	# list forward '6:tcp/443'     same, IPv6
	# list forward 'esp'           protocol 50, whole protocol
	# list input 'tcp/22'          the router's own services
	# list input 'icmp'            ping the router from the WAN
	#
	# UDP 68 and 546 are always allowed to the router itself (DHCP/DHCPv6
	# client replies) and do not need to be listed.
