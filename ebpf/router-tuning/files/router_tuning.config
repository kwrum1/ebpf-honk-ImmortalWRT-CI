# router-tuning - ebpf first-boot performance tuning
#
# Everything here is opt-out-able and reversible: `router-tuning report` shows
# what would happen without touching anything, and `router-tuning restore` puts
# the recorded original values back. Nothing in this package writes
# /etc/config/{network,dhcp,firewall}.
#
# Evidence for each of these knobs, and the ones we deliberately do NOT touch
# (CAKE's WAN qdisc, upstream packet_steering's rps_cpus, honk's rp_filter and
# socket buffers), is in docs/kernel-and-tuning-research.md.

config router_tuning 'global'
	option enabled '1'

	# auto | conservative | standard | aggressive
	#
	# auto picks by RAM: <=300 MB -> conservative, <=1200 MB -> standard,
	# otherwise aggressive. The tier only scales socket buffers, the softirq
	# backlog and the coalescing decision; the interface list and the CPU/IRQ
	# side are the same in every tier.
	option profile 'auto'

	# The sysctl set: buffer tiers, tcp_mtu_probing (PPPoE / blocked-ICMP PMTU
	# repair), wider ephemeral port range for einat's full-cone NAT, and the
	# slow-start/notsent pair that a proxy benefits from.
	option sysctl '1'

	# Use BBR when the module is available. Requires kmod-tcp-bbr, which this
	# package depends on; if the module is missing the line is skipped rather
	# than faked.
	option bbr '1'

	# Move net.core.default_qdisc to fq when sch_fq can be loaded, because that
	# is the pacing qdisc BBR is designed around. Skipped (and logged) when
	# sch_fq is not available: a default_qdisc the kernel cannot load leaves new
	# devices with no qdisc at all.
	option fq '1'

	# Ring sizes, offloads, coalescing and txqueuelen on the physical ports.
	option nic '1'

	# throughput | balanced | latency  -- what the NIC knobs optimise for.
	#   throughput : coalescing 32us, txqueuelen 5000, rings max  (bulk x86/RK)
	#   balanced   : coalescing 16us, txqueuelen 2000, rings max  (default)
	#   latency    : coalescing 0us,  txqueuelen 500,  rings max  (keeps p99 low
	#                at the cost of more interrupts; for a quiet box or VoIP)
	# Rings stay at the driver maximum in every mode: they bound drops, they do
	# not add queueing delay. Adaptive coalescing (driver-managed) is honoured
	# and left alone, because overriding it is how drivers are broken.
	option mode 'balanced'

	# xps_cpus per TX queue. Upstream packet_steering does not do this, so it is
	# the one steering item that is genuinely ours.
	option xps '1'

	# Fill rps_cpus only when the upstream packet_steering service is absent AND
	# every rps_cpus is still zero. This is a safety net, not a takeover.
	option rps_fallback '1'

	# scaling_governor -> performance where the platform offers it.
	option governor '1'

	# Space-separated device list to override autodetection. Empty = every
	# physical port that is not a bridge port, not a bridge/veth/dae device and
	# not the loopback.
	option interfaces ''
