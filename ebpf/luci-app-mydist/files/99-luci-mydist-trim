#!/bin/sh
# 99-luci-mydist-trim -- one-time defaults for this firmware's UI and posture.
#
#  1) No "Services" menu: SmartDNS and honk are network tools here and are
#     re-registered under Network by zz-mydist-network.json.
#  2) Firewall posture: open by default. The WAN zone forwards, IPv4 is full-cone
#     (fullcone + masq), and the catch-all "rule 999" (external source ->
#     internal destination, v4+v6) exists and ships ENABLED. Port control is
#     done from Network -> 防火墙, which writes stock fw4 redirects.
#  3) DNS: SmartDNS owns :53 and is the only resolver. dnsmasq keeps no DNS role
#     at all (port 0); odhcpd is the DHCP authority.
#
# mydist-posture re-applies the same values at every boot (S26). This script only
# makes the first boot *before* S26 consistent with them, so a boot that somehow
# never reaches S26 cannot leave rule 999 disabled or dnsmasq holding :53.
set -u

rm -f /usr/share/luci/menu.d/luci-app-firewall.json 2>/dev/null
rm -f /usr/share/luci/menu.d/luci-app-smartdns.json 2>/dev/null
rm -f /usr/share/luci/menu.d/luci-app-honk.json 2>/dev/null

# --- firewall posture -------------------------------------------------------
uci -q set firewall.@zone[1].forward='ACCEPT'
uci -q set firewall.@defaults[0].fullcone='1'
if ! uci -q get firewall.mydist999 >/dev/null 2>&1; then
	uci -q set firewall.mydist999='rule'
	uci -q set firewall.mydist999.name='999'
	uci -q set firewall.mydist999.src='wan'
	uci -q set firewall.mydist999.dest='lan'
	uci -q set firewall.mydist999.target='REJECT'
fi
uci -q set firewall.mydist999.enabled='1'
uci -q commit firewall

# --- DNS ownership ----------------------------------------------------------
uci -q set smartdns.@smartdns[0].port='53'
uci -q set dhcp.@dnsmasq[0].port='0'
uci -q set dhcp.@dnsmasq[0].noresolv='1'
uci -q delete dhcp.@dnsmasq[0].server
uci -q commit dhcp
uci -q commit smartdns

# IPv6: no invented ULA by default. A PPPoE / DHCPv6-PD uplink hands the LAN a
# real prefix; a random ULA only hides that (and NAT66 is not used here).
uci -q delete network.globals.ula_prefix
uci -q commit network

# Hide the dnsmasq half of the stock DHCP page: dnsmasq keeps the uci package
# (it owns /etc/config/dhcp) but has no DNS or DHCP role here. The page guards
# that section with hasSystemFeature(), which only looks at installed packages.
DHCP_JS=/www/luci-static/resources/view/network/dhcp.js
if [ -f "$DHCP_JS" ] && ! grep -q "if(false)" "$DHCP_JS"; then
	sed -i "s/if(L.hasSystemFeature('dnsmasq'))/if(false)/" "$DHCP_JS"
fi

/etc/init.d/dnsmasq stop >/dev/null 2>&1
/etc/init.d/dnsmasq disable >/dev/null 2>&1
/etc/init.d/smartdns restart >/dev/null 2>&1
/etc/init.d/firewall reload >/dev/null 2>&1

# --- QoS: on, with no knobs -------------------------------------------------
# router-qos used to take an upload rate plus five CAKE parameters. It now runs
# unlimited with one maintained policy (see /usr/libexec/router-qos.sh), so drop
# the settings older images carried and make sure it is on.
if [ -f /etc/config/router_qos ]; then
	uci -q delete router_qos.global.upload
	uci -q delete router_qos.global.overhead
	uci -q delete router_qos.global.mpu
	uci -q delete router_qos.global.diffserv
	uci -q delete router_qos.global.wash
	uci -q delete router_qos.global.nat
	uci -q set router_qos.global.enabled='1'
	uci -q commit router_qos
fi
rm -f /www/luci-static/resources/view/mydist/qos.js 2>/dev/null
# The package ships the init script but does not enable it by itself; without
# this the qdisc is only installed when someone restarts it by hand. (Measured
# on the bench: /etc/init.d/router-qos enabled -> false after a clean flash.)
[ -x /etc/init.d/router-qos ] && /etc/init.d/router-qos enable >/dev/null 2>&1
/etc/init.d/router-qos restart >/dev/null 2>&1

# --- dpd: downlink is default-on now ---------------------------------------
# `option downlink` did not exist in the first images, so an upgraded
# /etc/config/dpd_fastpath has no key at all and the init's `0` default keeps
# the return direction unaccelerated. Fill in the missing key only: an explicit
# 0 from the operator stays 0.
if [ -f /etc/config/dpd_fastpath ] &&
	! uci -q get dpd_fastpath.global.downlink >/dev/null 2>&1; then
	uci -q set dpd_fastpath.global.downlink='1'
	uci -q commit dpd_fastpath
fi

logger -t mydist "luci: firewall posture open + rule 999 on; SmartDNS owns :53; QoS on (no knobs)"
exit 0
