# mydist / luci-front -- the public HTTP(S) side of LuCI.
#
# The front end listens on :80 and :443 (HTTP/2, TLS, static /www) and proxies
# /cgi-bin/ and /ubus to uhttpd. uhttpd keeps only the two things it alone can do:
# running the Lua CGI (with its embedded interpreter) and bridging HTTP to ubus.
#
# Turning `enabled` off is the one-command rollback: the init then leaves the
# ports to uhttpd, which you re-open by putting its listen_http/https back.

config luci_front 'main'
	option enabled '1'
	option listen_http '0.0.0.0:80'
	option listen_https '0.0.0.0:443'
	option cert '/etc/uhttpd.crt'
	option key '/etc/uhttpd.key'
	option root '/www'
	option backend '127.0.0.1:8080'
	option dynamic '/cgi-bin/,/ubus'
	option hsts '1'
