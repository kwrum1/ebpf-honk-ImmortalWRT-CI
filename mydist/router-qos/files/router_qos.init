#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# mydist router-qos: CAKE on the WAN, upload direction.
#
#   tc qdisc replace dev <wan> root cake bandwidth <upload>kbit ...
#
# One qdisc, no classes, no classifier cascade -- CAKE does the per-flow
# fairness and the DSCP->tin mapping itself. The download direction is not
# shaped here; the reasons, with the measurement that settled it, are at the
# top of /usr/libexec/router-qos.sh.
#
# Default is enabled '1' with upload '0': loaded and ready, but it installs no
# qdisc until you give it a real link rate. It never "refuses" -- it logs what
# is missing and leaves the device alone, because a qdisc shaped to a made-up
# rate is worse than none.
#
# START is late, after network (and after router-acl, which owns the clsact
# qdisc), so that the WAN device exists by the time we replace its root qdisc.

START=97
STOP=03
USE_PROCD=1

. /usr/libexec/router-qos.sh

rq_load() {
	config_load router_qos
	config_get_bool RQ_ENABLED global enabled 0
	config_get RQ_WAN global wan wan
	config_get RQ_UP global upload 0
	config_get RQ_OVERHEAD global overhead 0
	config_get RQ_MPU global mpu 0
	config_get RQ_DIFFSERV global diffserv diffserv4
	config_get RQ_WASH global wash 0
	config_get RQ_NAT global nat 0
}

start_service() {
	local dev

	rq_load

	if [ "$RQ_ENABLED" != "1" ]; then
		rq_log "disabled; clearing any qdisc we may have left behind"
		rq_clear "$(rq_resolve_dev "$RQ_WAN")"
		return 0
	fi

	if [ "${RQ_UP:-0}" = "0" ]; then
		rq_log "refusing to start: upload is 0, nothing to shape"
		rq_clear "$(rq_resolve_dev "$RQ_WAN")"
		return 0
	fi

	dev="$(rq_resolve_dev "$RQ_WAN")"
	if [ -z "$dev" ]; then
		rq_log "WAN '$RQ_WAN' has no device yet; hotplug will retry on ifup"
		return 0
	fi

	rq_apply "$dev" "$(rq_cake_opts "$RQ_UP" "$RQ_OVERHEAD" "$RQ_MPU" \
		"$RQ_DIFFSERV" "$RQ_WASH" "$RQ_NAT")"
	rq_log "started: dev=$dev upload=$RQ_UP"
}

stop_service() {
	rq_load
	rq_clear "$(rq_resolve_dev "$RQ_WAN")"
	rq_log "stopped"
}

reload_service() {
	stop_service
	start_service
}

extra_command "status" "Show the WAN qdisc and the filter chains sharing the device" || true

status() {
	rq_load
	rq_status "$(rq_resolve_dev "$RQ_WAN")"
}
