#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Re-apply the CAKE qdisc whenever the WAN comes up or changes. This is what
# makes pppoe-wan work: the device does not exist at boot and is destroyed and
# recreated on every redial, taking its root qdisc with it.
#
# ACTION values are netifd's (see 90-dpd-fastpath for the list).

. /lib/functions.sh
. /usr/libexec/router-qos.sh

[ -n "$ACTION" ] || exit 0

rq_uci() {
	config_load router_qos
	config_get_bool RQ_ENABLED global enabled 0
	config_get RQ_WAN global wan wan
	config_get RQ_UP global upload 0
	config_get RQ_OVERHEAD global overhead 0
	config_get RQ_MPU global mpu 0
	config_get RQ_DIFFSERV global diffserv diffserv4
	config_get RQ_WASH global wash 0
	config_get RQ_NAT global nat 0
}

rq_selected() {
	local i

	[ -n "$INTERFACE" ] || return 1
	for i in $RQ_WAN; do
		[ "$i" = "$INTERFACE" ] && return 0
		[ -n "$DEVICE" ] && [ "$i" = "$DEVICE" ] && return 0
	done
	case "$INTERFACE" in
	wan|wan6|wan_6) return 0 ;;
	esac
	return 1
}

case "$ACTION" in
ifup|ifupdate|add|update)
	rq_uci
	[ "$RQ_ENABLED" = "1" ] || exit 0
	[ "${RQ_UP:-0}" = "0" ] && exit 0
	[ -n "$DEVICE" ] || exit 0
	rq_selected || exit 0

	rq_apply "$DEVICE" "$(rq_cake_opts "$RQ_UP" "$RQ_OVERHEAD" "$RQ_MPU" \
		"$RQ_DIFFSERV" "$RQ_WASH" "$RQ_NAT")"
	rq_log "hotplug $ACTION $INTERFACE -> $DEVICE applied"
	;;
ifdown|remove)
	[ -n "$DEVICE" ] || exit 0
	rq_uci
	rq_selected || exit 0
	rq_clear "$DEVICE"
	rq_log "hotplug $ACTION $INTERFACE -> $DEVICE cleared"
	;;
esac

exit 0
