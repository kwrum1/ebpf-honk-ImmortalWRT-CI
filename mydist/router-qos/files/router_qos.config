# router-qos - mydist CAKE QoS
#
# Default is enabled 1, but it stays inert until `upload` is set: the init logs
# "upload is 0, nothing to shape" and installs no qdisc. That is deliberate --
# CAKE shapes to the number you give it, and a made-up rate is worse than no
# shaping at all.
#
#   uci set router_qos.global.upload='<your real upload in kbit, minus a bit>'
#   uci commit router_qos
#   /etc/init.d/router-qos restart

config router_qos 'global'
	option enabled '1'

	# netifd logical name or bare device name. pppoe-wan works: the qdisc is
	# (re)applied on every ifup by /etc/hotplug.d/iface/92-router-qos.
	option wan 'wan'

	# Link rate in kbit. This is what CAKE shapes to, so put in the rate you
	# actually get, minus a little. 0 = do not install anything.
	#
	# Upload only. The download direction is deliberately not shaped: doing it
	# needs an IFB, and both ways of feeding one are wrong here -- a mirror
	# never actually delays the real packet (measured), and a redirect either
	# starves router-acl/dpd or changes the interface fw4 matches zones on.
	# The long version is at the top of /usr/libexec/router-qos.sh.
	option upload '0'

	# CAKE parameters. overhead is the per-packet framing cost in bytes (PPPoE
	# over Ethernet is 34 with the VLAN tag, 8 without; VDSL2 is usually
	# 22-30). mpu is the minimum packet size. diffserv4 gives four tins
	# (Bulk / Best Effort / Video / Voice); diffserv3 gives three; besteffort
	# disables the DSCP mapping.
	option overhead '0'
	option mpu '0'
	option diffserv 'diffserv4'

	# wash: clear the DSCP of packets coming from the LAN instead of trusting
	# it. nat: tell CAKE the router is doing NAT, which makes it remove the
	# per-host fairness split for flows it can see are going through the box.
	option wash '0'
	option nat '0'
