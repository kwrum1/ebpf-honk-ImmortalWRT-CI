# SPDX-License-Identifier: GPL-2.0-only
#
# mydist router-dataplane defaults.
#
# The accelerator is on by default, and it can be, because of one measured
# kernel fact: the transparent proxy (honk) owns TCX and sch_handle_ingress()
# runs tcx_run() before tc_run(). Every classic filter -- this one included --
# therefore sees only what the proxy already declined. dpd is structurally
# BEHIND honk, so "accelerate the rest" cannot starve the proxy, and no pref
# juggling is involved. dpd must stay a classic filter for that to hold.
#
# The other half is the return path. Taking a flow over skips netfilter, so its
# reply exists only because einat is the NAT (conntrack-free, on the WAN's TCX
# hooks) and its init hands fw4 a blanket WAN->LAN accept. That is why
# acceleration is *gated on einat being attached*: without it the mode is
# downgraded to observe at boot and every reason is logged. IPv6 is never
# accelerated for the same reason (no NAT66 in this baseline, so the reply would
# be untracked and fw4 would reject it).
#
# Set mode=off to make the program inert without detaching it.

config dpd 'global'
	# load the program and put it on the selected interfaces' ingress hook.
	# With this off, no maps exist and dpdctl has nothing to talk to.
	option attach '1'

	# killer switch read by the BPF program itself (dpd_cfg.enable).
	# 0 makes the program return TC_ACT_UNSPEC for everything, instantly.
	option enabled '1'

	# off         - attached, inert
	# observe     - does the FIB lookup and counts, never touches a packet
	# stateless   - every forwardable packet: decrement TTL, redirect  (default)
	# stateful    - learn on the first packet, redirect subsequent ones
	# neigh-probe - #14 bring-up probe for bpf_redirect_neigh()
	#
	# These are *requests*: the gates in the init script lower the effective
	# mode whenever the environment does not support it (no einat attached,
	# something sitting after us in the classic chain, uplink in the list).
	option mode 'stateless'

	# auto  - redirect_neigh() on ethernet, bpf_redirect() on NOARP/ppp
	# neigh - always redirect_neigh()
	# dev   - always bpf_redirect(ifindex, 0)
	option redirect 'auto'

	# how long a learned flow stays usable, in ms (stateful mode only)
	option flow_ttl_ms '5000'

	# Which packets we are allowed to take over.
	#   allow_all  - every IPv4 forwarding packet  (default)
	#   vlans_only - only VLAN ids in the `vlans` list below; untagged traffic is
	#                never eligible (fail-closed). Use this on a box with several
	#                LAN segments/zones, where accelerating between them would
	#                skip inter-zone firewall rules.
	option policy 'allow_all'

	# VLAN ids for policy=vlans_only, e.g.
	#	list vlans '10'
	#	list vlans '20'
	# The list is rebuilt from this file on every start; an empty list combined
	# with vlans_only therefore accelerates nothing.

	# netifd logical interfaces (or raw device names) to attach to.
	#
	# LAN-side only, on purpose. Accelerating on the uplink would skip
	# router-acl's nft guard and the input path for router-destined packets --
	# the uplink's inbound policy belongs to router-acl + fw4, not to us. The
	# init script refuses an uplink device even if it is named here.
	#
	# The hook layout (measured, see src/dpd_common.h) is:
	#   br-lan ingress: honk TCX lan_ingress_l2  -> us (pref 100)
	#   eth0  ingress : honk TCX lan_ingress_l2  -> us (pref 100)
	#   eth1  ingress : honk TCX + einat TCX + router-acl (pref 90) — no dpd
	list interfaces 'lan'
